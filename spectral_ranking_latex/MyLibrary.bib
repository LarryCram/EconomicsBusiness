@article{heronPublishingFlourishingWriting2021,
  ids = {heronPublishingFlourishingWriting2021a},
  title = {Publishing and Flourishing: Writing for Desire in Higher Education},
  author = {Heron, M. and Gravett, K. and Yakovchuk, N.},
  year = 2021,
  journal = {Higher Education Research and Development},
  volume = {40},
  number = {3},
  pages = {538--551},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360.2020.1773770},
  abstract = {In the current performative climate of higher education, where academic outputs are highly valorised, professional academic writing has become `high stakes' and is often framed as fraught with tension and anxiety. In this article, we contest the phrase `publish or perish' and argue that is not necessarily helpful or, indeed, always true. Through interviews involving critical incidents with a team of academics, the authors found that tensions in experiences of scholarly writing do indeed exist. However, participants also reported on the affordances of the process of professional academic writing in terms of developing ideas, collaborations, and creating spaces for creativity and desire. We emphasise the juxtaposition of the value of creation with the value of the finished product and argue that writing for publication needs to be highlighted as a process permeated with learning opportunities for both early career researchers and more experienced academics. \copyright{} 2020 HERDSA.},
  langid = {english},
  keywords = {/unread,academic literacies,desire,Professional academic writing,writing as process,writing as product}
}

@article{heronWritingProfessionalRecognition2020,
  title = {Writing for Professional Recognition in Higher Education: Understanding Genre and Expertise},
  author = {Heron, M. and Corradini, E.},
  year = 2020,
  journal = {Higher Education Research and Development},
  volume = {39},
  number = {5},
  pages = {968--981},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360.2019.1705256},
  abstract = {This study draws on the theoretical frameworks of genre theory and writing expertise to explore how educators manage and excel in writing for professional recognition. Semi-structured interviews were conducted with four educators from different disciplines in which participants discussed their experiences of preparing and writing for Senior Fellow. Despite the fact that writing for professional recognition can be a contentious genre to manage with its reflective features favouring those from certain disciplinary backgrounds, the participants described positive and affirming experiences. The findings also suggest that educators are strategic in their approach, and that the writing process can have unexpected affordances including a developed knowledge of writing, professional confidence and a sense of empowerment. The findings have implications for developing systems and resources to support educators preparing for fellowship. \copyright{} 2019, \copyright{} 2019 HERDSA.},
  langid = {english},
  keywords = {/unread,academic development,empowerment,genre theory,Professional academic writing,writing expertise}
}

