  author = {Kulczycki, Emanuel and P{\"o}l{\"o}nen, Janne and Laakso, Mikael and Ta{\c s}k{\i}n, Zehra},
  year = 2026,
  month = feb,
  journal = {Scientometrics},
  volume = {131},
