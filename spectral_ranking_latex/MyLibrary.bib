@article{mukhopadhyayWhereFreshmenAspirations2019,
  ids = {mukhopadhyayWhereFreshmenAspirations2019a},
  title = {Where Freshmen Aspirations Meet Reality: Factors Influencing the Learning Outcomes of a Living-and-Learning Program in an {{Asian}} University},
  author = {Mukhopadhyay, K. and Tambyah, S. K.},
  year = 2019,
  journal = {Higher Education Research and Development},
  volume = {38},
  number = {5},
  pages = {1015--1030},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360.2019.1598337},
  abstract = {This study explored the impact of a living-and-learning program (LLP) in a residential college of an Asian university on a freshmen cohort. It utilized a theoretical framework based on Astin's input-intermediate outcome-environment-outcome model. We examined survey data collected at two time points a year apart to understand how the freshmen's learning outcomes were influenced by their pre-college intentions and beliefs, their involvement and leadership in the LLP, and the LLP's environment. We found that pre-college perceived self-confidence had no impact on the learning outcomes. However, pre-college perceived competence in personal and intellectual growth was a significant contributing factor for involvement and post-college self-confidence. The freshmen's involvement in turn positively predicted their personal and intellectual growth and post-college self-confidence. The academic aspects of the LLP's environment also contributed to this growth. The findings have ramifications for the design of LLPs, in particular, the definition and measurement of learning outcomes, the criteria for admissions, and the facilitation of student involvement. \copyright{} 2019, \copyright{} 2019 HERDSA.},
  langid = {english},
  keywords = {/unread,Academic development,Asian higher education,community engagement,first-year experience,student learning}
}

