  shorttitle = {Coping with Methods for Delineating Emerging Fields},
  author = {{Mu{\~n}oz-{\'E}cija}, Teresa and {Vargas-Quesada}, Benjam{\'i}n and Chinchilla Rodr{\'i}guez, Zaida},
