@article{callenderDoesFearDebt2008,
  title = {Does the Fear of Debt Constrain Choice of University and Subject of Study?},
  author = {Callender, Claire and Jackson, Jonathan},
  year = 2008,
  journal = {Studies in Higher Education},
  volume = {33},
  number = {4},
  pages = {405--429},
  issn = {0307-5079},
  abstract = {The new student funding regime introduced by the 2004 Higher Education Act in England is predicated on the accumulation of student debt. Variable tuition fees, repaid by student loans, will increase average student loan debt on graduation. This article examines how fear of debt and financial constraints affect prospective students\^a\texteuro ™ choices of where and what to study. Using data derived from a survey of about 2000 prospective students, it shows that financial issues constrain lower social class students\^a\texteuro ™ choice of university far more than those from other social classes. It demonstrates that fear of debt is related to two key financially-driven decisions \^a\texteuro `` applying to a university with low living costs, and applying to one with good term-time employment opportunities \^a\texteuro `` but only for students from low-income families. However, concerns about debt do not influence their choice of qualification and subject. The article concludes that low-income students are more likely than their wealthier peers to perceive the costs of higher education as a debt rather than an investment.},
  keywords = {/unread}
}

