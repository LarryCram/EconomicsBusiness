@article{bloxhamExternalPeerReview2015,
  title = {External Peer Review of Assessment: An Effective Approach to Verifying Standards?},
  author = {Bloxham, S. and Hudson, J. and {den Outer}, B. and Price, M.},
  year = 2015,
  journal = {Higher Education Research and Development},
