  doi = {10.1080/07294360.2012.754410 10.1207/s15327906mbr3304_5; Steiger, J.H., (1989) EZPATH: A supplementary module for SYSTAT and SYGRAPH, , Evanston, IL,: SYSTAT; Tinto, V., (1993) Leaving college: Rethinking the causes and cures of student attrition research, , 2, Chicago, IL: University of Chicago; Tomarken, A.J., Waller, N.G., Potential problems with 'well fitting' models (2003) Journal of Abnormal Psychology, 112 (4), pp. 578-598; Trigwell, K., Dunbar-Goddet, H., (2005) The research experience of postgraduate research students at the University of Oxford, , Oxford, Oxford,: Institute for the Advancement of University Learning, University of Oxford; (2005) Education quality work: The Hong Kong experience, , University Grant Committee, Hong Kong, Hong Kong,: The Hong Kong Polytechnic University, Educational Development Centre; (2010) Student enrolment (headcount) of UGC-funded programmes by institution, level of study, mode of study and sex, 2003/2004 to 2009/2010, , http://cdcf.ugc.edu.hk/cdcf/searchStatisticReport.do;jsessionid=500C8F94F775AAF3E031409CEF72C4ED#, University Grant Committee, Retrieved November 26, 2010, from; Watkins, D., Correlates of approaches to learning: A cross-cultural meta-analysis (2001) Perspectives on thinking, learning, and cognitive styles, pp. 165-195. , In: Sternberg R.J., Zhang L., editors Mahwah, NJ: Lawrence Erlbaum Associates; Webster, B.J., Chan, W.S.C., Prosser, M.T., Watkins, D.A., Undergraduates' learning experience and learning process: Quantitative evidence from the East (2009) Higher Education, 58 (3), pp. 375-386; Welsh, J., The PhD student at work (1981) Studies in Higher Education, 6 (2), pp. 159-162; Wright, T., Cochrane, R., Factors influencing successful submission of PhD theses (2000) Studies in Higher Education, 25 (2), pp. 181-195; Zeng, M., Watkins, D.A., Adaptation to a sibling culture: The satisfaction and persistence intentions of Mainland Chinese postgraduate students at a Hong Kong university (2007) Asian Journal of University Education, 1 (3), pp. 39-62; Zeng, M., Watkins, D.A., Adaptation of Mainland postgraduate students to the Hong Kong's universities (2010) Crossing borders in East Asian higher education, pp. 343-373. , In: Chapman D. W., Cummings W. K., Postiglione G. A., editors Hong Kong, Hong Kong,: Comparative Education Research Centre},
  abstract = {To date, there has been little research in non-Western contexts exploring the research experience of research higher degree (RHD) students and the effect of research experience on student outcomes. The purposes of this study were to validate the Student Research Experience Questionnaire (SREQ) developed in Australia in the Hong Kong context and to explore the relationships between student research experiences and their perceived skill development and overall satisfaction with their research degree experiences. Data were collected from 599 RHD students. The results supported the construct validity of four SREQ scales (supervision, infrastructure, intellectual climate and skill development). The results of the structural equation modelling suggested that supervision related to students' perceived skill development and overall satisfaction, while intellectual climate and infrastructure were related to overall satisfaction only. The data provide a better understanding of how we can promote positive learning outcomes of RHD students. \copyright{} 2013 Copyright HERDSA.},
  langid = {english},
