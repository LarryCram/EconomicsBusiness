@article{russellRethinkingGenreSociety1997,
  title = {Rethinking Genre and Society: An Activity Theory Analysis},
  author = {Russell, David R.},
  year = 1997,
  journal = {Written Communication},
  volume = {v14},
  number = {n4},
  pages = {p504(51)},
  issn = {0741-0883},
  abstract = {The relation between writing in formal schooling and writing in other social practices is a central problem in writing research (e.g., pedagogy, writing in nonacademic settings, cognition in variable social contexts. How do macro-level social and political structures (forces) affect micro-level literate actions in classrooms and vice versa? To address these questions, the author synthesizes Yrjo Engestrom's systems version of Vygotskian cultural-historical activity theory with Charles Bazerman's theory of genre systems. The author suggests that this synthesis extends Bakhtinian dialogic theory by providing a broader unit of analysis that text-as-discourse, wider levels of analysis among disciplinary and educational genre systems, through the boundary of classroom genre systems, one can construct a model of ways classroom writing is linked to writing in wider social practices and rethink such issues as agency, representation, and assessment. A model synthesizing activity theory and genre systems theory is constructed to facilitate research into the relationship between student classroom writing and the other kinds of writing performed by individuals in the broader social and political contexts of their lives. The model seeks to bridge the gap existing between the teaching of writing in higher education institutions and the uses to which writing is actually put in the society and professions likely to be inhabited by writing students. The model may be used to analyze contextual impacts upon the development of student writers' styles and motivations.},
  keywords = {/unread,Composition (Language arts)_Study and teaching,Language arts_Social aspects,Social aspects,Study and teaching,Written communication_Social aspects}
}

