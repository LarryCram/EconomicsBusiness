@article{yangConsolidationDisruptionNovel2023,
  title = {From Consolidation to Disruption: {{A}} Novel Way to Measure the Impact of Scientists and Identify Laureates},
  author = {Yang, Alex J. and Hu, Haotian and Zhao, Yuehua and Wang, Hao and Deng, Sanhong},
  year = {2023/9//},
  journal = {Information Processing \&amp; Management},
  volume = {60},
  number = {5},
  pages = {103420},
  issn = {0306-4573},
  doi = {10.1016/j.ipm.2023.103420},
  abstract = {This study proposes a novel approach for evaluating the impact of scientists by introducing a new set of metrics and a dual measurement framework that combines the concepts of disruption and consolidation. Traditional metrics like total citation and h-index are limited in their ability to capture the full range of a scientist's influence, and therefore the Scientists' Disruptive Citation (SDC), Disruptive h-index (D h-index), and consolidating metrics are introduced to provide a more comprehensive evaluation of scientists' disruptive and consolidating influence. Using a dataset of 463,348 papers, 234,086 disambiguated scientists, and data on three important awards, including Nobel Prize, Wolf Prize, and Dirac Medal, in the field of Physics, this study demonstrates that the SDC and D h-index are superior to all benchmark metrics, including the conventional and normalized disruption-based measures, in terms of convergent validity. Second, this study analyzes the distribution of academic characteristics between award-winning and non-laureates, explores various metrics of scientists with high SDC and Scientists' Consolidating Citation (SCC), and finds that disruptive impact can identify successful scientists from their counterparts and serve as an early signal of successful scientists. Third, this study reveals that the disruptive citation proposed in this study is less susceptible to manipulation, making it a more reliable metric for assessing a scientist's or a single paper's disruptive impact than the CD-index. The results suggest that the SDC and D h-index are reliable metrics for measuring scientists' innovative influence and can aid in the development of future scientific research. Overall, this study provides a scientifically sound and effective new perspective on measuring scientists using a dual measurement of disruptive and consolidating influence.},
  langid = {english},
  keywords = {/unread}
}

@article{yangDisruptionCoefficientDevelopment2022,
  title = {Disruption {{Coefficient}}, {{Development Coefficient}} and {{Their}} 2-{{Step Versions}} as {{Basic Measures}} in {{Directed Information Networks}}},
  author = {Yang, Alex Jie and Deng, Sanhong and Wang, Hao and Zhang, Yiqin and Yang, Wenxia},
  year = 2022,
  journal = {SSRN Electronic Journal},
  issn = {1556-5068},
  doi = {10.2139/ssrn.4239544},
  abstract = {In this study, we introduce the disruption coefficient (DIO) and development coefficient (DEO) as basic measures for detecting critical nodes in directed networks with the perspective of innovation. To expand the information dimension, we further propose the 2-step versions of the measures (2stepDIO and 2stepDEO). The theoretical foundations of this study are information theory (Shannon, 1948) and disruption indices (Wu et al., 2019). The new measures combine the focal nodes\^a\texteuro ™ prior information and posterior information, by measuring the extent to which they disrupt the previous network paradigm, which distinguishes them from traditional measures, e.g., degree and betweenness. Moreover, the properties of the measures are elaborated, with an empirical study on citation networks for papers published in Journal of Informetrics from 2010-2017. We also checked the convergent validity and consistency of the metrics. It turns out that DIO and 2stepDIO have significant yet weak correlations with other measures. Based on these findings, we argue that DIO and 2stepDIO are vital and irreplaceable for detecting the critical nodes in directed information networks, as they can reflect the innovation level rather than merely the influence.},
  langid = {english},
  keywords = {/unread},
  file = {/home/lc/snap/zotero-snap/common/Zotero/storage/N9D6UKQ4/Yang et al. - 2022 - Disruption Coefficient, Development Coefficient and Their 2-Step Versions as Basic Measures in Direc.pdf}
}

