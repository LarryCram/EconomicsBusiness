  title = {The Ideal Research-Teaching Nexus in the Eyes of Academics: {{Building}} Profiles},
  author = {{Visser-Wijnveen}, G. J. and {van Driel}, J. H. and {van der Rijst}, R. M. and Verloop, N. and Visser, A.},
