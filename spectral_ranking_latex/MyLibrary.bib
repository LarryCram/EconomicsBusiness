@article{vroeijenstijnAutonomyAssuranceQuality1990,
  title = {Autonomy and {{Assurance}} of {{Quality}}: {{Two Sides}} of {{One Coin}} the {{Case}} of {{Quality Assessment}} in {{Dutch Universities}}},
