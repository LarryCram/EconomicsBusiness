@article{gentryContinualNeedImprovement2009,
  title = {The Continual Need for Improvement to Avoid Derailment: {{A}} Study of College and University Administrators},
  author = {Gentry, W. A. and Katz, R. B. and McFeeters, B. B.},
  year = 2009,
  journal = {Higher Education Research and Development},
  volume = {28},
  number = {3},
  pages = {335--348},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360902839925},
  abstract = {Understanding what relates to the behaviours associated with derailment (i.e. failure or burnout in managerial positions) may prevent costly outcomes of derailment for the manager, co-workers and the organization. The outcomes of derailment are especially pertinent with those working in college and university administration as many, including faculty, other staff and students, depend on these administrators. Data collected about 173 middle- and top-level college and university administrators from 88 different colleges and universities across the USA revealed that self- and observer-ratings (peers and direct reports) of willingness to improve negatively related to boss ratings of derailment. Specifically, the more administrators were willing to improve (and the more others believed those administrators were willing to improve), the less likely it was that bosses believed those administrators displayed the characteristics and behaviours associated with derailment. We conclude with a discussion of our findings including guidance for college and university administrators. \copyright{} 2009 HERDSA.},
  langid = {english},
  keywords = {/unread,College and university administrators,Managerial derailment,Peers and direct reports,Relationships,Willingness to improve}
