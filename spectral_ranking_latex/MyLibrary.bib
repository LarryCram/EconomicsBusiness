  year = 1986,
  journal = {Higher Education Research and Development},
  volume = {5},
  number = {2},
  pages = {147--159},
  issn = {07294360 (ISSN)},
  doi = {10.1080/0729436860050204},
  abstract = {This paper recounts the experiences of three faculty and a group of graduate teachers as they experimented with a classroom mode of in-service education known as ``clinical supervision''. It was used as a way of teachers gaining entry into an analysis of their own teaching. Unlike most university courses this one did not start out to ``tell'' these experienced teachers anything of a prescriptive kind. Rather, it provided them with a framework within which they could begin to collaboratively examine their own practice. Journals and diaries were used as the main method by which these experienced teachers were able to engage in reflective conversations with their work contexts. The study reports on some of the strengths as well as the problems of this way of working, and points to some further agenda in need of exploration. \copyright{} 1986, Taylor \& Francis Group, LLC. All rights reserved.},
  langid = {english},
  keywords = {/unread}
}

@article{smythSpeakingBackEducational,
  title = {Speaking Back to Educational Policy: Why Social Inclusion Will Not Work for {\emph{Disadvantaged}} {{Australian}} Schools},
  author = {Smyth, John},
  journal = {Critical Studies in Education},
  volume = {51},
  number = {2},
  pages = {113--128},
  issn = {1750-8487},
  abstract = {The Labor government in Australia has recently embarked on an extremely ambitious program of social inclusion for the most marginalized groups in society. Drawing upon the approach of \emph{policy scholarship} this paper examines some federal government \^a\texteuro\texttildelow policy texts\^a\texteuro ™ to describe what has occurred and asks questions about what is meant by the social inclusion policy orientation in the context of educational disadvantage. It challenges the efficacy of uncritically following the experience of New Labour in England as the basis for an Australian social inclusion agenda. The paper concludes with the need to include the voices of \^a\texteuro\texttildelow policy users\^a\texteuro ™, who are supposed to be the beneficiaries, in the construction of more reflexive alternatives.},
  keywords = {/unread}
}

