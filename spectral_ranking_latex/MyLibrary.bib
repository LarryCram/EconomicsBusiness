@article{fiorentinoClinicalReportsPulmonary2011a,
  title = {Clinical Reports of Pulmonary Metastasectomy for Colorectal Cancer: A Citation Network Analysis},
  author = {Fiorentino, F. and Vasilakis, C. and Treasure, T.},
