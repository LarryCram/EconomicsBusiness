  title = {A Influ\^encia de Autocita\c c\~oes Em Decis\~oes Editoriais e No {{Fator}} de {{Impacto}}: Uma An\'alise a Partir Da Simula\c c\~ao de Redes de Cita\c c\~ao},
  booktitle = {Anais {{VI WIDAT}}},
  author = {Correia, Luiz Gabriel and {Mena-Chalco}, Jes{\'u}s Pascual},
  year = 2023,
  pages = {1--11},
  publisher = {Instituto Brasileiro de Informa\c c\~ao em Ci\^encia e Tecnologia},
  doi = {10.22477/vi.widat.48},
  abstract = {Introdu\c c\~ao: A manipula\c c\~ao do Fator de Impacto de Peri\'odicos (JIF) por meio de decis\~oes editoriais que aumentam autocita\c c\~oes vem sendo verificada empiricamente em estudos recentes, levantando discuss\~oes a respeito de como evitar m\'as pr\'aticas. Objetivo: Este trabalho tem como objetivo verificar se uma pol\'itica de remo\c c\~ao das autocita\c c\~oes do c\'alculo do JIF \'e suficiente para remover os incentivos \`a manipula\c c\~ao. Metodologia: Introduzimos um modelo baseado em agentes da rede social acad\^emica formada pelos peri\'odicos para testar tal hip\'otese. N\'os modelamos os peri\'odicos como agentes racionais buscando ganhar posi\c c\~oes no ranking JIF. Resultados: Os resultados das simula\c c\~oes mostram que a remo\c c\~ao de autocita\c c\~oes consegue reduzir significativamente a ado\c c\~ao de estrat\'egias de manipula\c c\~ao (e.g., redu\c c\~ao de 90\% para 30\%). Conclus\~ao: Esse estudo contribui para compreens\~ao do papel das autocita\c c\~oes no JIF e fornece ferramentas para o desenvolvimento de pol\'iticas que promovam a integridade da ci\^encia.},
  keywords = {/unread},
  file = {/home/lc/snap/zotero-snap/common/Zotero/storage/CE5JPCSC/Correia-A influência de autocitações em decisõ.pdf;/home/lc/snap/zotero-snap/common/Zotero/storage/IR8LCXZF/Correia-A influência de autocitações em decisõ.pdf}
