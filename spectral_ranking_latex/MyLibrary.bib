 places (1986) Writing culture: The poetics and politics of ethnography, pp. 27-50. , In: Clifford J., Marcus G. E., editors Berkeley, Berkeley,: University of California Press; Scutt, C.H., (2002) Creation and critique: Reclaiming ethnography and utopia, , Unpublished doctoral thesis, Murdoch University, Western Australia; St. Pierre, E.A., Methodology in the fold and the irruption of transgressive data (1997) International Journal of Qualitative Studies in Education, 10 (2), pp. 175-189. , doi:10.1080/095183997237278; Stanley, L., Wise, S., (1983) Breaking out: Feminist consciousness and feminist research, , London, London,: Routledge; Stierer, B., Antoniou, M., Are there distinctive methodologies for pedagogic research in higher education? (2004) Teaching in Higher Education, 9 (3), pp. 275-285. , doi:10.1080/1356251042000216606; Stoller, P., Ethnographies as texts/Ethnographers as griots (1994) American Ethnologist, 21 (2), pp. 353-366. , doi:10.1525/ae.1994.21.2.02a00070; Svensson, L., Theoretical foundations of phenomenography (1997) Higher Education Research & Development, 16 (2), pp. 159-171. , doi:10.1080/0729436970160204; Tight, M., Eleven years of Studies in Higher Education (2011) Studies in Higher Education, 36 (1), pp. 1-6. , doi:10.1080/03075079.2011.553395; Trowler, P., Wicked issues in situating theory in close-up research (2012) Higher Education Research & Development, 31 (3), pp. 273-284. , doi:10.1080/07294360.2011.631515; Tsing, A.L., (1993) In the realm of the Diamond Queen: Marginality in an out-of-the-way place, , Princeton, NJ, Princeton, NJ,: Princeton University Press; Tummons, T., Theoretical trajectories within communities of practice in higher education research (2012) Higher Education Research & Development, 31 (3), pp. 299-310. , doi:10.1080/07294360.2011.631516; van Manen, M., (1997) Researching the lived experience, , London, Ontario, London, Ontario,: Althouse Press; Visweswaran, K., (1994) Fictions of feminist ethnography, , Bloomington, IN, Bloomington, IN,: University of Minnesota Press; Weedon, C., (1987) Feminist practice and poststructuralist theory, , London, London,: Blackwell; Wolf, M., (1992) A thrice told tale: Feminism, postmodernism, and ethnographic responsibility, , Stanford, CA, Stanford, CA,: Stanford University Press},
  abstract = {As higher education research is largely practised by those immersed within the university, the questions we ask, and the stories we tell, over time co-create the university itself. Using Bruner's concept of the 'narrative mode', we argue for a revaluing of narrative and storytelling within higher education research. We ground our discussion in examples of research challenges where traditional quantitative methodologies leave certain things unsayable and look to our two disciplines - anthropology and philosophy - for solutions to these challenges. Anthropology's intimate and complex historical relationship with narrative offers us a range of narrative devices - unusual plots for research accounts, rich data, an ability to tell individual stories in micro-time and wider group narratives. Philosophy offers us a new view of imagination in epistemology and allows us to extend the boundaries of sight beyond individuals, considering the possibility of examining the university itself as a character, a reflexive subject. We argue that our disciplines' capacities to tell these rare tales - oddly shaped personal narratives, group narratives, narratives with unusual characters, quests, reversals and tricksters, and stories that ultimately morph back into questions - allow us to find again some of the 'forgotten things' of higher education research. \copyright{} 2013 Copyright HERDSA.},
  langid = {english},
  keywords = {/unread,anthropology,higher education research,narrative,phenomenology,research methodologies}
}

@article{seaboyerNewPerspectivesReading2019,
  ids = {seaboyerNewPerspectivesReading2019a},
  title = {New Perspectives on Reading and Writing across the Disciplines},
  author = {Seaboyer, J. and Barnett, T.},
  year = 2019,
  journal = {Higher Education Research and Development},
  volume = {38},
  number = {1},
  pages = {1--10},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360.2019.1544111},
  abstract = {There's a level of public anxiety that at times approaches moral panic around the argument that those born into a digital age have lost the ability as well as the desire to read or write long-form text. That anxiety haunts higher education, too. From rigorous research in the reading-heavy disciplines to conversations among colleagues after class, the internet is often held as responsible for the failure of too many of our students to be able to read enough disciplinary material in enough depth to allow them to take the next steps in the dialogic that constitutes a university education. We look to research that suggests that to blame changing technology is at best an oversimplification. While the capacity to deep read complex texts and to respond orally and in writing are foundational skills that are complicated by the rise of digital technologies, research on what has come to be termed reading non-compliance suggests the problem is of much longer standing. The ways in which we engage text may have changed, but the failure to read for class preceded digital technologies and their distractions (Hobson). We argue we can best serve our students now by encouraging biliteracy (Wolf and Barzillai) so they are able to shift between the reading-for-information that involves scanning, clicking, and linking, and the deep, immersive reading vital for the rich and productive engagement that enables critical, creative, and ethical learning. \copyright{} 2018, \copyright{} 2018 HERDSA.},
  langid = {english},
  keywords = {/unread,aliteracy,biliteracy,Deep reading,digital reading: hospitable reading,hybridity,reading technologies,student engagement,writing},
  file = {/home/lc/snap/zotero-snap/common/Zotero/storage/M42TXQAC/Seaboyer and Barnett - 2019 - New perspectives on reading and writing across the disciplines.pdf}
}

