@article{fialaPageRankbasedPredictionAwardwinning2017,
  title = {{{PageRank-based}} Prediction of Award-Winning Researchers and the Impact of Citations},
  author = {Fiala, Dalibor and Tutoky, Gabriel},
  year = {2017/11//},
  journal = {Journal of Informetrics},
  volume = {11},
  number = {4},
  pages = {1044--1068},
  issn = {1751-1577},
  doi = {10.1016/j.joi.2017.09.008},
  abstract = {In this article some recent disputes about the usefulness of PageRank-based methods for the task of identifying influential researchers in citation networks are discussed. In particular, it focuses on the performance of these methods in relation to simple citation counts. With the aim of comparing these two classes of ranking methods, we analyze a large citation network of authors based on almost two million computer science papers and apply four PageRank-based and citations-based techniques to rank authors by importance throughout the period 1990--2014 on a yearly basis. We use ACM SIGMOD E. F. Codd Innovations Award and ACM A. M. Turing Award winners in our baseline lists of outstanding scientists and define four relevance weighting schemes with some predictive power for the ranking methods to increase the relevance of researchers winning in the future. We conclude that citations-based rankings perform better for Codd Award winners, but PageRank-based methods do so for Turing Award recipients when using absolute ranks and PageRank-based rankings outperform the citations-based techniques for both Codd and Turing Award laureates when relative ranks are considered. However, the two ranking groups show smaller differences if more weight is assigned to the relevance of future awardees.},
  langid = {english},
  keywords = {/unread},
  file = {/home/lc/snap/zotero-snap/common/Zotero/storage/6W2NC8VW/1-s2.0-S175115771730038X-main.pdf;/home/lc/snap/zotero-snap/common/Zotero/storage/PAG45SX4/Faila - pagerank award winning.pdf;/home/lc/snap/zotero-snap/common/Zotero/storage/YWSXZYBK/1-s2.0-S175115771730038X-main.pdf}
}

@article{fialaPageRankBibliographicNetworks2008,
  title = {{{PageRank}} for Bibliographic Networks},
  author = {Fiala, Dalibor and Rousselot, Fran{\c c}ois and Je{\v z}ek, Karel},
  year = {2008/5/22/},
  journal = {Scientometrics},
  volume = {76},
