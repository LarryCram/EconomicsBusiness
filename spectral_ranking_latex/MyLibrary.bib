@article{larranjorgeAnalysingLiteratureUniversity2017,
  title = {Analysing the Literature on University Social Responsibility: {{A}} Review of Selected Higher Education Journals},
  author = {Larr{\'a}n Jorge, M. and Andrades Pe{\~n}a, F. J.},
  year = 2017,
  journal = {Higher Education Quarterly},
  volume = {71},
