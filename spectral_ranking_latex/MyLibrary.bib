@article{flemingSmallWorldsRegional2007,
  title = {Small Worlds and Regional Innovation},
  author = {Fleming, L. and King Iii, C. and Juda, A. I.},
  year = 2007,
  journal = {Organization Science},
  volume = {18},
  number = {6},
  pages = {938--954},
  issn = {10477039 (ISSN)},
  doi = {10.1287/orsc.1070.0289},
  abstract = {Small-world networks have attracted much theoretical attention and are widely thought to enhance creativity. Yet empirical studies of their evolution and evidence of their benefits remain scarce. We develop and exploit a novel database on patent coauthorship to investigate the effects of collaboration networks on innovation. Our analysis reveals the existence of regional small-world structures and the emergence and disappearance of giant components in patent collaboration networks. Using statistical models, we test and fail to find evidence that small-world structure (cohesive clusters connected by occasional nonlocal ties) enhances innovative productivity within geographic regions. We do find that both shorter path lengths and larger connected components correlate with increased innovation. We discuss the implications of our findings for future social network research and theory as well as regional innovation policies. \copyright{} 2007 INFORMS.},
  langid = {english},
  keywords = {/unread,Innovation,Regional advantage,Small-world networks}
}

