@article{priceUsingTechnologyTeaching2014,
  title = {Using Technology for Teaching and Learning in Higher Education: {{A}} Critical Review of the Role of Evidence in Informing Practice},
  author = {Price, L. and Kirkwood, A.},
  year = 2014,
  journal = {Higher Education Research and Development},
  volume = {33},
  number = {3},
