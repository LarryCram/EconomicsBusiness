@article{manarinWhyRead2019,
  title = {Why Read?},
  author = {Manarin, K.},
  year = 2019,
  journal = {Higher Education Research and Development},
  volume = {38},
  number = {1},
  pages = {11--23},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360.2018.1527296},
  abstract = {Why read? What is the point of reading in higher education if students can succeed in their classes without reading? Using Wigfield and Eccles' Expectancy-Value theory of motivation as a framework, I explore why different instructors think their students should be reading and whether students share these motivations. Instructors and students attribute value to reading differently. Instructors value reading for what it allows students to do and become. Students may value reading but still not read depending on competing factors including time available and assessment tasks required. The essay concludes by asking higher educational professionals to consider what, if anything, should be done to encourage the reading of difficult texts in classes. \copyright{} 2018, \copyright{} 2018 HERDSA.},
