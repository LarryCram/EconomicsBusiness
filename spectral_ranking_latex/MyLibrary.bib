}

@article{rattrayAffectIpsativeApproaches2018,
  ids = {rattrayAffectIpsativeApproaches2018a},
  title = {Affect and Ipsative Approaches as a Counter to Pedagogic Frailty: The Guardian of Traditional Models of Student Success},
  author = {Rattray, J.},
  year = 2018,
  journal = {Higher Education Research and Development},
  volume = {37},
  number = {7},
  pages = {1489--1500},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360.2018.1494141},
  abstract = {In this article, I consider how the neoliberal discourses surrounding higher education have resulted in an increasingly risk-averse culture of learning and teaching. Students are frequently reluctant to engage with troublesome or challenging knowledge and academics are less likely to push learners into contested spaces or deviate from accepted pedagogical practices for fear of upsetting them. The consequence of this situation is that we potentially have a generation of graduates who lack the resilience to cope in the graduate market. Drawing on the notion of pedagogic frailty, consideration is given to how models of success, that are associated with high stakes, single-point assessment, might limit the development of positive affect in learners. I argue instead for a reconsideration of notions of success building on the principles of ipsative assessment as a means of supporting the development of affective attributes, such as resilience, optimism and hope, in an effort to ensure graduates are equipped for an uncertain future. \copyright{} 2018, \copyright{} 2018 HERDSA.},
  langid = {english},
  keywords = {/unread,Assessment,emotions,pedagogy,student learning,teaching},
  file = {/home/lc/snap/zotero-snap/common/Zotero/storage/H3TPRS2K/Rattray - 2018 - Affect and ipsative approaches as a counter to pedagogic frailty the guardian of traditional models.pdf}
}

