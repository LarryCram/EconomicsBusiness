@article{abramoEvaluatingUniversityResearch2015,
  title = {Evaluating University Research: {{Same}} Performance Indicator, Different Rankings},
  shorttitle = {Evaluating University Research},
  author = {Abramo, Giovanni and D'Angelo, Ciriaco Andrea},
  year = 2015,
  month = jul,
  journal = {Journal of Informetrics},
