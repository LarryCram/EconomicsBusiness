@article{motionTransformativeLearningApproaches2014,
  title = {Transformative Learning Approaches for Public Relations Pedagogy},
  author = {Motion, J. and Burgess, L.},
  year = 2014,
  journal = {Higher Education Research and Development},
  volume = {33},
  number = {3},
