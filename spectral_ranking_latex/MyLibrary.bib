@article{wellsHowWeKnow2015,
  title = {``{{How}} We Know What We Know'': {{A}} Systematic Comparison of Research Methods Employed in Higher Education Journals, 1996-2000 v. 2006-2010},
  author = {Wells, R. S. and Kolek, E. A. and Williams, E. A. and Saunders, D. B.},
  year = 2015,
  journal = {Journal of Higher Education},
  volume = {86},
  number = {2},
  pages = {171--198},
  doi = {10.1353/jhe.2015.0006},
  abstract = {This study replicates and extends a 2004 content analysis of three major higher education journals. The original study examined the methodological characteristics of all published research in these journals from 1996 to 2000, recommending that higher education programs adjust their graduate training to better match the heavily quantitative and statistically sophisticated journal content. We examine the same journals' content from 2006 to 2010---one decade later---through the lens of knowledge production in higher education, and explore the ways that dominant modes of research may legitimize and/or delegiti-mize various forms of inquiry. Our fndings reveal a feld that continues to be dominated by quantitative methods and which is increasingly using more advanced statistical techniques. We discuss the tensions of a feld more aligned with federal and state priorities and therefore better positioned to infuence policy, but with a concomitantly contracted scope of and approach to inquiry. We also discuss implications for the training of graduate students, professionals, and policymakers as well as implications for publishing and researching other aspects of knowledge production in higher education. \copyright{} 2015 by the ohio state University.},
  keywords = {/unread,Content analysis,Higher education research,Replication,Research design,Research methods}
}

