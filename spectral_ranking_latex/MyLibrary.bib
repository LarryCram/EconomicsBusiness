@article{halevyStatusConferralIntergroup2012,
  title = {Status Conferral in Intergroup Social Dilemmas: {{Behavioral}} Antecedents and Consequences of Prestige and Dominance},
  author = {Halevy, Nir and Chou, Eileen Y. and Cohen, Taya R. and Livingston, Robert W.},
