@article{parkesBeingMoreHuman2020,
  ids = {parkesBeingMoreHuman2020a},
  title = {Being More Human: Rooting Learning Analytics through Resistance and Reconnection with the Values of Higher Education},
  author = {Parkes, S. and Benkwitz, A. and Bardy, H. and Myler, K. and Peters, J.},
  year = 2020,
  journal = {Higher Education Research and Development},
  volume = {39},
  number = {1},
  pages = {113--126},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360.2019.1677569},
  abstract = {Universities are now compelled to attend to metrics that (re)shape our conceptualisation of the student experience. New technologies such as learning analytics (LA) promise the ability to target personalised support to profiled `at risk' students through mapping large-scale historic student engagement data such as attendance, library use, and virtual learning environment activity as well as demographic information and typical student outcomes. Yet serious ethical and implementation issues remain. Data-driven labelling of students as `high risk', `hard to reach' or `vulnerable' creates conflict between promoting personal growth and human flourishing and treating people merely as data points. This article argues that universities must resist the assumption that numbers and algorithms alone can solve the `problem' of student retention and performance; rather, LA work must be underpinned by a reconnection with the agreed values relating to the purpose of higher education, including democratic engagement, recognition of diverse and individual experience, and processes of becoming. Such a reconnection, this article contends, is possible when LA work is designed and implemented in genuine collaboration and partnership with students. \copyright{} 2019, \copyright{} 2019 HERDSA.},
  langid = {english},
  keywords = {/unread,becoming,complexity,dialogue and partnership,Learning analytics,student retention},
  file = {/home/lc/snap/zotero-snap/common/Zotero/storage/JMSHSE4C/Parkes et al. - 2020 - Being more human rooting learning analytics through resistance and reconnection with the values of.pdf}
}

