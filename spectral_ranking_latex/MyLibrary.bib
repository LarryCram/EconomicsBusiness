@incollection{wellsLargeNationalDatasets2015,
  title = {Large National Datasets},
  booktitle = {Research in the {{College Context}}: {{Approaches}} and {{Methods}}},
  author = {Wells, R.},
  year = 2015,
  pages = {185--197},
  publisher = {{Taylor and Francis}},
  abstract = {Higher education journals are dominated by survey research using quantitative methods. From 2006-2010, over 80 percent of all studies in the three main higher education journals (Journal of Higher Education, Research in Higher Education, and Review of Higher Education) used quantitative methods, and nearly as many (over 70 percent) analyzed data collected from surveys (Wells, Kolek, Williams, \& Saunders, 2015). Among the studies that used survey data, those using secondary data were more prevalent than those using primary data by about two to one. Of the secondary data sources utilized, researchers used large national surveys for nearly half, indicating that these are a valuable source of data for higher education, and therefore a subject about which researchers should be knowledgeable. However, given the thorough treatments of both survey research (Chapter 10) and secondary data analysis (Chapter 11), specifically, is it really necessary to have a chapter dedicated to the topic of large national datasets? For three main reasons, I think it is. \copyright{} 2016 Taylor \& Francis.},
