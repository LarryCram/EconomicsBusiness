@article{leeDoesHigherEducation2015,
  title = {Does Higher Education Foster Critical and Creative Learners? {{An}} Exploration of Two Universities in {{South Korea}} and the {{USA}}},
  author = {Lee, H. J. and Lee, J. and Makara, K. A. and Fishman, B. J. and Hong, Y. I.},
