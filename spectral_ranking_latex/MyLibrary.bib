@article{fisherTransformingTwentyfirstcenturyCampus2014,
  title = {Transforming the Twenty-First-Century Campus to Enhance the Net-Generation Student Learning Experience: Using Evidence-Based Design to Determine What Works and Why in Virtual/Physical Teaching Spaces},
