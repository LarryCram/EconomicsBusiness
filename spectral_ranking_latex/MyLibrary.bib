@article{barrowTruthAcademicDevelopment2012,
  title = {The 'truth' of Academic Development: {{How}} Did It Get to Be about 'Teaching and Learning'?},
  author = {Barrow, M. and Grant, B.},
  year = 2012,
  journal = {Higher Education Research and Development},
  volume = {31},
  number = {4},
  pages = {465--477},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360.2011.602393},
  abstract = {The nature of academic development in contemporary universities has been a recent focus in the literature. Highlighting the diversity of practices that exist under its name, 'academic development' has been described by some as an ambiguous project and a fragmented field, while others suggest a more coherent project, pointing out a near universal concern with, in particular, teaching and learning. Through an exploration of the practices of the first academic developers in New Zealand, and a consideration of the particular institutions in which they were operating, this article draws on the work of Foucault to consider the modalities of power that were available to them. This exploration is used as a basis from which to consider the systems of truth that began to emerge as a result of the early appointees' practice, in particular their original and enduring concern with teaching and learning as objects of knowledge. \copyright{} 2012 Copyright HERDSA.},
  langid = {english},
  keywords = {/unread,academic development,Foucault,learning,modalities of power,teaching}
}

