@article{silfverWeAreOrphans2016,
  title = {`{{We}} Are like Orphans': Exploring Narratives of {{Lao}} Doctoral Alumni Educated in {{Sweden}}},
  author = {Silfver, A. L. and Berge, B. M.},
  year = 2016,
  journal = {Higher Education Research and Development},
  volume = {35},
  number = {3},
