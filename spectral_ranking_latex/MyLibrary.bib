  doi = {10.1080/07294360.2020.1752629 10.1002/ace.7401; Mintz, A.I., (2018) Plato: Images, aims, and practices of education, , Cham: Springer International Publishing Springer; Moeller, V.J., Moeller, M.V., (2014) Socratic seminars in high school: Texts and films that engage students in reflective thinking and close reading, , New York, London: Taylor & Francis; Moore, T.J., Critical thinking and disciplinary thinking: A continuing debate (2011) Higher Education Research & Development, 30 (3), pp. 261-274; Morse, R.A., The classic method of Mrs. Socrates (1994) The Physics Teacher, 32 (5), pp. 276-277. , https://doi.org/10.1119/1.2343996%20doi:10.1119/1.2343996; Overholser, J.C., Socrates in the classroom (1992) College Teaching, 40 (1), pp. 14-19; Paul, R., Elder, L., Critical thinking: The art of Socratic questioning (2007) Journal of Developmental Education, 31 (1), pp. 36-37; Paul, R., Elder, L., Critical thinking: The art of Socratic questioning, part III (2008) Journal of Developmental Education, 31 (3), pp. 34-35; Piro, J., Anderson, G., Discussions in a Socrates café: Implications for critical thinking in teacher education (2015) Action in Teacher Education, 37 (3), pp. 265-283; Ramsey, I., Gabbard, C., Clawson, K., Lee, L., Henson, K.T., Questioning: An effective teaching method (1990) The Clearing House: A Journal of Educational Strategies, Issues and Ideas, 63 (9), pp. 420-422; Sharifi, A., Murayama, A., Neighborhood sustainability assessment in action: Cross-evaluation of three assessment systems and their cases from the US, the UK, and Japan (2014) Building and Environment, 72, pp. 243-258; Sternberg, R.J., Answering questions and questioning answers: Guiding children to intellectual excellence (1994) The Phi Delta Kappan, 76 (2), pp. 136-138. , http://www.jstor.org/stable/20405276; Styhre, A., Gluch, P., Creativity and its discontents: Professional ideology and creativity in architect work (2009) Creativity and Innovation Management, 18 (3), pp. 224-233; (2011), http://www.sd-commission.org.uk/pages/history_sd.html, History of sustainable development; Talen, E., The social goals of new urbanism (2002) Housing Policy Debate, 13 (1), pp. 165-188; Talen, E., (2013) Charter of the new urbanism: Congress for the new urbanism, , Second ed., New York: McGraw Hill Education; Talen, E., Allen, E., Bosse, A., Ahmann, J., Koschinsky, J., Wentz, E., Anselin, L., LEED-ND as an urban metric (2013) Landscape and Urban Planning, 119, pp. 20-34; Todd, D., Acid and water: A Socratic dialogue (1993) Journal of Chemical Education, 70 (12), p. 1022; (2009) USGBC LEED AP neighborhood development study guide, , Washington, DC: USGBC Books; (2017) Education for sustainable development goals: Learning objectives, , Paris: United Nations Educational, Scientific and Cultural Organization; (2015), https://sustainabledevelopment.un.org/sdgs, Transforming our world: The 2030 agenda for sustainable development; Uzzell, D., Pol, E., Badenas, D., Place identification, social cohesion, and environmental sustainability (2002) Environment and Behavior, 34 (1), pp. 26-53; Walker, J.B., Seymour, M.W., Utilizing the design charrette for teaching sustainability (2008) International Journal of Sustainability in Higher Education, 9 (2), pp. 157-169; Wilberding, E., (2014) Teach like Socrates: Guiding Socratic dialogues & discussions in the classroom, , Waco, Texas: Prufrock Press, Inc; Wilen, W.W., (1987) Questions, questioning techniques, and effective teaching, , Washington, D.C.: NEA Professional Library, National Education Association, (ed},
  abstract = {This study addresses the problem of facilitating critical thinking about the real-world complexities that underlie the Sustainable Development (SD) concept among university students of architecture. The Socratic Seminar was adopted because of its characteristic exploratory questions that are closely aligned to the question-types used by the lecturer in previous years during student-requested one-to-one tutorial sessions aimed at clarifying SD concepts. The findings of this study indicate that the interactive learning session fostered a collaborative community of critical thinkers as well as a mind-shift in students' preconceived idea of SD, suggesting that transformative learning had occurred. Furthermore, the Socratic Seminar facilitated observation of whether students in a group setting could critically apply previously acquired theoretical knowledge to assessing SD in the context provided by the multimedia material viewed. The Socratic Seminar was shown to be a useful educational tool for specifically eliciting the complexities of SD among architecture and urban planning students, thereby building on the pedagogy applied in one-to-one student-driven initiatives. \copyright{} 2020, \copyright{} 2020 HERDSA.},
  langid = {english},
  keywords = {/unread,collaboration competency,critical thinking,Education for Sustainable Development (ESD),Socratic Seminar,Sustainable Development (SD),transformative learning,urban planning and design}
}

