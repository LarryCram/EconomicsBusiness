}

@article{watsonExploringRelatednessField2004,
  title = {Exploring Relatedness to Field of Study as an Indicator of Student Retention},
  author = {Watson, G. and Johnson, G. C. and Austin, H.},
  year = 2004,
  journal = {Higher Education Research and Development},
  volume = {23},
  number = {1},
  pages = {57--72},
  issn = {07294360 (ISSN)},
  doi = {10.1080/0729436032000168496},
  abstract = {Currently, tertiary education student retention is an important concern for universities. Prior research suggests that course completion depends on a number of factors, many of which are recalcitrant to intervention. This paper explores one factor: student relatedness to their chosen course and profession, as evidenced within two education courses. The analysis of survey and focus group data from first year, semester one students has found that the respondents relate to their course and their profession more idealistically than pragmatically. We suggest that relative unawareness of the realities of teaching might retain students in the early years, only to cause attrition when harsher realities of classrooms set in during the later years of their course. Two possible interventions are considered: post-structurally-derived critical reflection and peer mentoring in the hope that they will facilitate a blend of idealism and pragmatism that will sustain students to course completion and entry into their profession. \copyright{} 2004, Taylor \& Francis Group, LLC.},
  langid = {english},
  keywords = {/unread}
}

