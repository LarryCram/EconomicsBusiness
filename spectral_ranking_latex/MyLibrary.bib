@article{bazeleyVocationalCollegeNew1994,
  ids = {bazeleyVocationalCollegeNew1994a},
  title = {From {{Vocational College}} to {{New University}}: {{The Research Profile}} and {{Development Needs}} of {{Academic Staff}} in a {{Period}} of {{Transition}}},
  author = {Bazeley, P.},
  year = 1994,
  journal = {Higher Education Research and Development},
  volume = {13},
  number = {2},
  pages = {121--132},
  issn = {07294360 (ISSN)},
  doi = {10.1080/0729436940130203},
  abstract = {Promoted by the provision of special funding for research development from the Department of Employment, Education and Training, an analysis of the research status and development needs of staff one network member of a newly amalgamated University was undertaken. It was found that many staff were without research-based qualifications and had limited research experience. Teaching and curriculum development were dominant activities, the latter being particularly so in some of the newer disciplines. It was felt by many that there was a lack of institutional support for research by senior management in general and in some faculties in particular, as people in those positions took time to adjust to the changing climate of expectations in the transition from College to University. Specific research skills needing development were identified, including submission writing, statistical data analysis and reporting research. The availability of time and money for research were, predictably, seen as critical. In a conclusion unanticipated at the commencement of the study, the emergence of a widely recognised and supported research ethos was perceived as perhaps the most significant element to contribute to the development of research in a new university. \copyright{} 1994, Taylor \& Francis Group, LLC. All rights reserved.},
  langid = {english},
  keywords = {/unread}
}

