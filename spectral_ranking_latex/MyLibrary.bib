@article{pearsonApproachesIndividualisingInstruction1983,
  title = {Approaches to {{Individualising Instruction}} --- {{A Review}}},
  author = {Pearson, M.},
  year = 1983,
  journal = {Higher Education Research and Development},
  volume = {2},
  number = {2},
  pages = {155--181},
  issn = {07294360 (ISSN)},
  doi = {10.1080/0729436830020203},
  abstract = {Although there is an extensive literature available on individualised instruction and self-paced learning, much of it concerns particular methods and systems. This review looks at the development of individualised instruction, identifies issues and problems common to all variants and assesses the evidence on outcomes in terms of student achievement, student access, costs, and the role of the teacher. It is concluded that: individualised instruction is unlikely to reduce costs; may improve access but not automatically for all target groups; requires a commitment on the part of the teachers to be effective; provides a range of strategies which extend the options to educators intent on improving teaching and learning. \copyright{} 1983, Taylor \& Francis Group, LLC. All rights reserved.},
  langid = {english},
  keywords = {/unread}
}

