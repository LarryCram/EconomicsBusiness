@article{libbyGrantSuccessEarlyCareer2016,
  title = {Grant {{Success}} for {{Early-Career Faculty}} in {{Patient-Oriented Research}}: {{Difference-in-Differences Evaluation}} of an {{Interdisciplinary Mentored Research Training Program}}},
  author = {Libby, Anne M. and Hosokawa, Patrick W. and Fairclough, Diane L. and Prochazka, Allan V. and Jones, Pamela J. and Ginde, Adit A.},
  year = {2016/12//},
