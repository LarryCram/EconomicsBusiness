  author = {Muurlink, O. and Matas, C. P.},
  year = 2011,
  journal = {Higher Education Research and Development},
  volume = {30},
  number = {6},
  pages = {751--764},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360.2010.539597},
  abstract = {This article is the first comprehensive review of speed dating in the tertiary sector. While speed dating has its origins as a networking technique to connect singles, it has only more recently made its way into the academy. Since 2005 universities world-wide have begun to adopt speed dating protocols as a tool for building research culture. An extensive review of the brief history of speed dating in university settings indicates that the motivation for organising events tends to fall into six clusters. Each motivation is discussed here, as well as two potential as-yet-unexplored outcomes for research students in academe: increasing wellbeing through improving social relations and aiding the conceptualising of theses. Finally the authors raise the need for further research in this area to establish its real impact and to identify best practices. \copyright{} 2011 Copyright HERDSA.},
  langid = {english},
  keywords = {/unread,academic capital,professional development,research students,speed networking,wellbeing}
}

