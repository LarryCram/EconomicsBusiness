@article{zengMeasuringResearchExperience2013,
  title = {Measuring the Research Experience of Research Postgraduate Students in {{Hong Kong}}},
  author = {Zeng, L. M. and Webster, B. J. and Ginns, P.},
  year = 2013,
  journal = {Higher Education Research and Development},
