@article{haqEconomicPolicyUncertainty2021,
  title = {Economic {{Policy Uncertainty}} and {{Cryptocurrency Market}} as a {{Risk Management Avenue}}: {{A Systematic Review}}},
  author = {Haq, Inzamam Ul and Maneengam, Apichit and Chupradit, Supat and Suksatan, Wanich and Huo, Chunhui},
