@article{lewWritingLearnCan2011,
  title = {Writing to Learn: {{Can}} Reflection Journals Be Used to Promote Self-Reflection and Learning?},
  author = {Lew, D. N. M. and Schmidt, H. G.},
  year = 2011,
  journal = {Higher Education Research and Development},
  volume = {30},
  number = {4},
  pages = {519--532},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360.2010.512627},
  abstract = {The purpose of the present study was to evaluate whether there is evidence of reflection in student-written journals and to investigate whether students show improvements in their reflective skills through journal keeping. To that end, the reflection journals of 3460 first-year students enrolled in a polytechnic were studied by means of an automated coding procedure. Data used in the analyses were students' journals for an entire week, collected once at the beginning and again at the end of an academic year. Outcomes of the content analyses suggest that there is evidence of reflection in students' journals and that students reflected on three general categories related to their learning: critical review of past learning experiences, cognitive learning strategies and summaries of what was learnt. Furthermore, the findings also indicate that students show improvements in their reflective skills as they progressed through the academic year. The findings when taken together suggest that reflection journals can be used to promote self-reflection and learning amongst students. \copyright{} 2011 Copyright HERDSA.},
  langid = {english},
  keywords = {/unread,learning,metacognition,reflection journals,self-reflection,text analysis}
}

