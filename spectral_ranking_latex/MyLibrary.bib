@article{wangAcademicAcculturation22021,
  title = {Academic Acculturation in 2 + 2 Joint Programmes: Students' Perspectives},
  author = {Wang, Y. X. and Bai, L.},
  year = 2021,
  journal = {Higher Education Research and Development},
