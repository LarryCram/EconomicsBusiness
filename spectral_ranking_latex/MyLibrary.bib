., O'Donnell, V., Zammit, M., Exploring transition to postgraduate study: Shifting identities in interaction with communities, practice and participation (2010) British Educational Research Journal, 36 (2), pp. 261-278. , doi:10.1080/01411920902836360; (2009) Promoting the UK doctorate: Challenges and opportunities, , UUK, Research report. London: Author; Wakeling, P., (2003) Social class and progression to postgraduate study in England, , Unpublished MA dissertation, University of York; Wakeling, P., La noblesse d'etat anglasie? Social class and progression to postgraduate study (2005) British Journal of Sociology of Education, 26 (4), pp. 505-522. , doi:10.1080/01425690500200020; Wakeling, P., (2009) A comparison of comparatively little, , June, Paper presented at the 2nd International RESUP Conference, Lausanne, Switzerland; Wakeling, P., Are ethnic minorities underrepresented in UK postgraduate study? (2009) Higher Education Quarterly, 63 (1), pp. 86-111. , doi:10.1111/j.1468-2273.2008.00413.x; Wakeling, P., (2009) Social class and access to postgraduate education in the UK: A sociological analysis, , Unpublished PhD thesis. University of Manchester; Wakeling, P., Kyriacou, C., (2010) Widening participation from undergraduate to postgraduate research degrees, , Swindon, UK, Swindon, UK,: NCCPE and ESRC; Waters, J.L., In pursuit of scarcity: Transnational students, 'employability' and the MBA (2009) Environment and Planning A, 41 (8), pp. 1865-1883. , doi:10.1068/a40319; Zimdars, A., Testing the spill-over hypothesis: Meritocracy in enrolment in postgraduate education (2007) Higher Education, 54 (1), pp. 1-19. , doi:10.1007/s10734-006-9043-3},
  abstract = {Widening participation is on the political agenda but, to date, policy, practice and research has focused on undergraduate education. This article identifies an emerging widening participation focus on doctoral education. Using England as a case study, the article examines this development within the context of the long-standing concern with equity in education, before reviewing the relatively small literature addressing who participates (and why) in doctoral and more general postgraduate education. An analysis of Widening Participation Strategic Assessments produced in 2009 by 129 English Higher Education Institutions (HEIs) reveals an emergent institutional awareness of this new development. Finally, a research agenda for widening participation to research degrees, focusing on research students, HEIs and policy-makers, is outlined. The conclusion calls for this agenda to be pursued at institutional, national and cross-national levels so that future policy can be made and implemented on the basis of a robust evidence base. \copyright{} 2013 Copyright HERDSA.},
  langid = {english},
  keywords = {/unread,doctoral education,higher education policy,student diversity}
}

@article{mcdadeStatusIncongruitySamoan2002,
  title = {Status {{Incongruity}} in {{Samoan Youth}}: {{A Biocultural Analysis}} of {{Culture Change}}, {{Stress}}, and {{Immune Function}}},
  author = {McDade, Thomas W.},
  year = {2002/6//},
  journal = {Medical Anthropology Quarterly},
  volume = {16},
  number = {2},
  pages = {123--150},
  issn = {0745-5194},
  doi = {10.1525/maq.2002.16.2.123},
  abstract = {In Samoa, the presence of a matai title in the family has historically been a valued source of social status. However, as the process of Westernization continues, new sources of social status are emerging. This study explores the degree to which new and old markers of social status agree--or disagree--and the consequences they have for the experience of stress in 329 Samoan adolescents. The study integrates cultural and biological methods and data, and measures an aspect of immune function (antibodies against the Epstein-Barr virus) as a biomarker of psychosocial stress. Results indicate that status "incongruent" adolescents experience significantly more stress (indicated by reduced immune function), and that emerging markers of social status are becoming inextricably linked to "traditional" markers in such a way that discordance between them is a significant source of stress. This study proposes new conceptual models for future studies of culture change and suggests that biomarkers may represent ethnographic tools that can provide insight into hidden cultural dynamics and the experience of stress.},
  langid = {english},
  keywords = {/unread}
}

