@article{sasanguieDisentanglingInstructionalRoles2011,
  title = {Disentangling Instructional Roles: {{The}} Case of Teaching and Summative Assessment},
  author = {Sasanguie, D. and Elen, J. and Clarebout, G. and {van den Noortgate}, W. and Vandenabeele, J. and {de Fraine}, B.},
  year = 2011,
  journal = {Studies in Higher Education},
  volume = {36},
  number = {8},
  pages = {897--910},
  doi = {10.1080/03075079.2010.482206},
  abstract = {While in some higher education contexts a separation of teaching and summative assessment is assumed to be self-evident, in other contexts the opposite is regarded to be obvious. In this article the different arguments supporting either position are analyzed. Based on a systematic literature review, arguments for and against are classified at the micro-, meso- and macro-level. Articles specifically discuss the way in which making use of an external examiner influences the learning environment, the quality assurance policy and the policy of an institution with respect to the outside world (users, other institutions, etc.). In addition, the literature reveals that the suggested arguments and positions for and against disentangling instructional roles are highly context specific. Strikingly, empirical evidence for these arguments is rather scarce. There is a need, therefore, for a systematic research program which investigates the influence of the large and diverse set of assumptions and presuppositions on the disentangling of instructional roles. \copyright{} 2011 Copyright Society for Research into Higher Education.},
  keywords = {/unread,accountability,higher education,summative assessment,teacher roles,tutoring}
}

