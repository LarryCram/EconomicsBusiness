@article{dunnIdStruggleSee2021,
  ids = {dunnIdStruggleSee2021a},
  title = {`{{I}}'d Struggle to See It as Cheating': The Policy and Regulatory Environments of Study Drug Use at Universities},
  author = {Dunn, M. and Dawson, P. and Bearman, M. and Tai, J.},
  year = 2021,
  journal = {Higher Education Research and Development},
  volume = {40},
  number = {2},
  pages = {234--246},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360.2020.1738351},
  abstract = {Students use various licit and illicit substances to enhance their academic performance. As yet, no study has explored whether this is an issue of concern for those working in the higher education sector. This study aimed to explore study drug policy, regulatory environments and responses within Australian universities. Semi-structured interviews were conducted with 14 participants from five Australian universities. Nine participants were based in school/department, faculty, or institutional head of teaching and learning roles; six participants were in student support roles. Eight participants had direct teaching experience. Three themes emerged from the data analysis. Study drug use was seen as a health problem rather than a threat to academic integrity. Participants believed that attributes of the university setting may facilitate study drug use, but also considered that some attributes may prevent the uptake of use, such as a stronger emphasis on universities promoting the benefits of a balanced lifestyle. \copyright{} 2020 HERDSA.},
  langid = {english},
  keywords = {/unread,academic integrity,cognitive enhancement,higher education,Study drugs,university policy}
}

