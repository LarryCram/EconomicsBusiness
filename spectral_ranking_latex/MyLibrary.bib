  number = {3},
  pages = {15--24},
  issn = {07360983},
  abstract = {Generally, state funds either are not appropriated to support this sector or are appropriated only for a specific purpose, e.g., to fund a research-related economic development activity. Because it is largely self-supporting, states should be pleased when revenues from this sector grow, just as they are pleased when private business revenues grow. Costs in this sector are covered by a mix of state appropriations, tuition, gifts, and endowment earnings.},
