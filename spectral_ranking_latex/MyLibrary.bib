@article{bordognaAdvocatingAdministeringCritical2020,
  title = {Advocating and Administering Critical Realism in a Study of Transnational Educational Collaborative Partnerships},
  author = {Bordogna, C. M.},
  year = 2020,
  journal = {Higher Education Research and Development},
  volume = {39},
  number = {5},
  pages = {883--897},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360.2019.1704691},
  abstract = {Transnational higher education is an increasingly important and essential part of the internationalisation of higher education. As the number of global educational institutions and international students participating in these types of initiatives increases, it becomes of paramount importance that research methodologies that investigate the phenomenon are developed and shared within transnational research communities. This article seeks to contribute to transnational education research by exploring a paradigm that has the potential to generate alternative forms of knowledge concerning transnational collaborative partnerships. By exploring functionalist and interpretivist approaches, often applied in partnership research, this article argues that neither approach, when applied in isolation, can fully articulate the notion of a TNE collaborative partnership. The article therefore champions the application of critical realism when investigating these partnerships and provides an empirical example of two Chinese-British case studies to illustrate the application of the paradigm, followed by a vignette of the type of findings generated, and its value to research and practice. \copyright{} 2019, \copyright{} 2019 HERDSA.},
  langid = {english},
  keywords = {/unread,Critical realism,internationalisation,research design,sociological paradigms,transnational education collaborative partnerships},
