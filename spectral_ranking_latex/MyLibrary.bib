@article{marcusIdeaNationalHumanities1975,
  title = {The {{Idea}} of the {{National Humanities Center}}},
  author = {Marcus, Steven},
  year = 1975,
  journal = {Bulletin of the American Academy of Arts and Sciences},
  volume = {28},
  number = {4},
  pages = {6--10},
  issn = {0002712X},
  doi = {10.2307/3823238},
  abstract = {[On the initiative of Morton Bloomfield of Harvard and Gregory Vlastos of Princeton, a Planning Committee composed of leading scholars in the various humanistic disciplines was formed in the spring of 1973 to determine the feasibility of establishing a national institute for advanced humanistic studies. The American Academy agreed to serve as the institutional base for the planning and development activities associated with this project. During the past year the Planning Committee organized several meetings to define the nature and scope of the proposed Center, including a national conference held in April 1974 at Wingspread, Racine, Wisconsin. At the meeting, a group of scholars with wide geographic and disciplinary representation discussed all aspects of the proposal, made useful recommendations, and responded enthusiastically to the concept of a national institute focussing on humanistic activity. The National Humanities Center would be an autonomous institution, located near a major university with suitable arrangements to share that university's resources. It would consist of forty to fifty Fellows invited for one year; there would also be a small administrative and supporting staff. Numerous universities have indicated their interest in cooperating with the Planning Committee in the development of the proposed Center. In recent months, members of the Planning Committee have made site visits to a number of institutions, several of which have offered to provide land, buildings, and financial assistance for the Center. In addition to a decision on the location of the Center, major activities of the Planning Committee during the forthcoming year will be the identification of long-term funding sources and the definition in some detail of the physical and organizational structure of the Center. In the following statement, Steven Marcus, Professor of English at Columbia University and Staff Planning Officer for the Center, outlines the objectives of the National Humanities Center.]},
  keywords = {/unread},
  file = {/home/lc/snap/zotero-snap/common/Zotero/storage/AYFXYUB2/Marcus-The Idea of the National Humanities Cen.pdf;/home/lc/snap/zotero-snap/common/Zotero/storage/CQ8EILP3/Marcus-The Idea of the National Humanities Cen.pdf}
}

@article{margetsonQuestionledDesignDegree1987,
  title = {The {{Question-led Design}} of a {{Degree Programme}}},
  author = {Margetson, D.},
  year = 1987,
  journal = {Higher Education Research and Development},
  volume = {6},
  number = {2},
  pages = {151--173},
  issn = {07294360 (ISSN)},
  doi = {10.1080/0729436870060206},
  abstract = {This article discusses a question-led approach to the design of a new degree programme in computing and information studies, the Bachelor of Informatics, at Griffith University in Brisbane, Australia. Basic considerations arising from various theories which have given a central place to problems and questions in human activity are outlined. Some implications of these considerations for the role and place of questions in education are discussed in terms of the notions of focussing, opening, and activating. It is argued that these notions are important in understanding education to be, in part, vitally concerned with critical inquiry. The specific context at Griffith University in which the question-led approach came to be adopted is described, together with an account of a report concerning the planning of a new academic activity in the University which was made available to the planning group at the commencement of planning. The processes by which this approach was implemented in the design phase are described briefly. The resulting design, as it existed shortly prior to the commencement of teaching, is described. The conclusion discusses some issues arising from experience in the design and implementation of this programme, and provides some evaluative feedback from staff and second-year students obtained during the second year during which the programme was offered (1986). Copyright \copyright{} 1987 by Taylor \& Francis Group, LLC. All rights reserved.},
  langid = {english},
  keywords = {/unread}
}

