@article{lederPeerPerspectivesTeaching1987,
  title = {Peer {{Perspectives}} on {{Teaching}}: {{A Case Study}} in {{Mathematics}}},
  author = {Leder, G. and Jones, P. and Paget, N. and Stillwell, J.},
  year = 1987,
  journal = {Higher Education Research and Development},
