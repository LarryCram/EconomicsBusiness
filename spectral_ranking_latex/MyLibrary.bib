@article{liuAnomalousCitationsDetection2024,
  title = {Anomalous Citations Detection in Academic Networks},
  author = {Liu, Jiaying and Bai, Xiaomei and Wang, Mengying and Tuarob, Suppawong and Xia, Feng},
