@article{wenhamMakeBreakRole2020,
  ids = {wenhamMakeBreakRole2020a},
  title = {Make or Break: The Role and Support Needs of Academic Advisors in Work-Integrated Learning Courses},
  author = {Wenham, K. E. and {Valencia-Forrester}, F. and Backhaus, B.},
  year = 2020,
  journal = {Higher Education Research and Development},
  volume = {39},
  number = {5},
  pages = {1026--1039},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360.2019.1705254},
  abstract = {The role of academic advisors in work-integrated learning courses is crucial to student success, yet poorly understood. This research aimed to understand the role and support needs of academic advisors by conducting interviews, a survey, and a focus group within a service learning program in Queensland, Australia. Participants identified rewards in observing student transformation and supporting students to contribute to social justice causes. However, the role had high demands in terms of pastoral support. Although academic advisors reported strong support mechanisms, they identified gaps in supporting them to meet the needs of international students and students with mental health issues. Academic advisors need strong mentoring or supervisory support to deal with diverse student issues, clear processes for tracking and managing students, training and resources to deal with special needs students, and opportunities for team building and bonding. Supporting academic advisors could help to better support students to successfully complete internships. \copyright{} 2019, \copyright{} 2019 HERDSA.},
