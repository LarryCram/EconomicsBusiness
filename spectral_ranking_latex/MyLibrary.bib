@article{chanAcademicDisciplineModerating2021,
  title = {Academic Discipline as a Moderating Variable between Seating Location and Academic Performance: Implications for Teaching},
  author = {Chan, K. L. and Chin, D. C. W. and Wong, M. S. and Kam, R. and Chan, B. S. B. and Liu, C. H. and Wong, F. K. K. and Suen, L. K. P. and Yang, L. and Lam, S. C. and Lai, W. W. L. and Zhu, X.},
  year = 2021,
  journal = {Higher Education Research and Development},
  doi = {10.1080/07294360.2021.1928000},
  abstract = {Previous research on university students' academic performance indicates that students' seating locations can be an indicator of their academic performance. However, previous research on the relationship between university students' seating locations and their academic performance is mixed, and there is a lack of research about whether students' academic discipline moderates this relationship. This study addresses this gap in the literature through a study of 182 university students in Hong Kong. Biglan categorization was used to classify disciplines into soft (a low degree of consensus) and hard fields (a high degree of consensus). The results revealed that students from soft fields who sat at the front of a class performed better than their counterparts who sat at the back, while the performance of students from hard fields was not significantly influenced by their seating location. This article's findings suggest that classroom seating arrangements should be tailored to academic disciplines to maximize their efficacy and that universities should redesign classroom layouts to extend the experience of sitting at the front of a class to all students. \copyright{} 2021 HERDSA.},
  keywords = {/unread,academic disciplines,academic performance,Biglan categorization,iBeacon/BLE technology,Seating location},
  file = {/home/lc/snap/zotero-snap/common/Zotero/storage/NQL2E3IX/Chan et al. - 2021 - Academic discipline as a moderating variable between seating location and academic performance impl.pdf}
}

