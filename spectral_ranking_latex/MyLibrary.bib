@article{Tibaná-Herrera2018,
  title = {Global Analysis of the {{E-learning}} Scientific Domain: A Declining Category?},
  author = {{Tiban{\'a}-Herrera}, Gerardo and {Fern{\'a}ndez-Baj{\'o}n}, Mar{\'i}a Teresa and {de Moya-Aneg{\'o}n}, F{\'e}lix},
  year = 2018,
