@article{ammiganInternationalVisitingScholar2021,
  title = {The International Visiting Scholar Experience: Insights from an Importance-Satisfaction Study},
  author = {Ammigan, R. and Caro, C. E.},
  year = 2021,
  journal = {Higher Education Research and Development},
  doi = {10.1080/07294360.2021.1962813},
  abstract = {The number of international visiting scholars engaged in research and teaching at institutions of higher education in the United States has increased significantly over the past two decades. While there is an extensive body of literature dedicated to understanding the acculturation process of international students, very little research has focused on the experiences of visiting scholars at their host institution. Using the importance-satisfaction model as a conceptual framework, this study investigates the experiences of over 100 international visiting scholars at a mid-sized university in the Mid-Atlantic region of the US. Specifically, it examines the importance and satisfaction ratings of various aspects of their program across ten different dimensions of institutional experience. Analyses from the present research reveal gaps in service quality, indicating areas where additional resources and improvement in support and services might be needed. Implications for university administrators and host departments are discussed. \copyright{} 2021 HERDSA.},
