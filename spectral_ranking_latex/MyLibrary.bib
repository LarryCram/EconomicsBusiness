@article{dawsonEffectivenessSupplementalInstruction2014,
  title = {On the {{Effectiveness}} of {{Supplemental Instruction}}: {{A Systematic Review}} of {{Supplemental Instruction}} and {{Peer-Assisted Study Sessions Literature Between}} 2001 and 2010},
  author = {Dawson, P. and {van der Meer}, J. and Skalicky, J. and Cowley, K.},
  year = 2014,
  journal = {Review of Educational Research},
  volume = {84},
  number = {4},
  pages = {609--639},
  doi = {10.3102/0034654314540007},
  abstract = {Supplemental instruction (SI)---variously known as peer-assisted learning, peer-assisted study sessions, and other names---is a type of academic support intervention popular in higher education. In SI sessions, a senior student facilitates peer learning between undergraduates studying a high-risk course. This article presents a systematic review of the literature between 2001 and 2010 regarding the effectiveness of SI. Twenty-nine studies met the inclusion criteria. Due to methodological heterogeneity and lack of consistency defining the SI treatment, qualitative synthesis methods were applied. For seven included studies, however, an effect size of SI participation on final grades was calculated, ranging from d = 0.29 to d = 0.60. The findings of the review are consistent with claims validated by the U.S. Department of Education in the 1990s that participation in SI is correlated with higher mean grades, lower failure and withdrawal rates, and higher retention and graduation rates. \copyright{} 2014 AERA.},
  keywords = {/unread,effectiveness,PASS,peer learning,supplemental instruction,systematic review}
}

