@article{hancockWhoNewerResearcher2016,
  title = {Who Is the Newer Researcher into Higher Education? {{Locating}} Ourselves in Shifting Terrains},
  author = {Hancock, S. and Clegg, S. and Crossouard, B. and Kahn, P. and Weller, S.},
  year = 2016,
  journal = {Higher Education Research and Development},
  volume = {35},
  number = {2},
  pages = {282--295},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360.2015.1087384},
  abstract = {This article aims to deconstruct the underpinning tenets of the term `newer researcher into higher education'. In recognition of the ambiguities of the term, we begin by questioning the nature of the field(s) of research into higher education (HE). Secondly, we critique the policy discourses associated with the term `newer researcher'. Then, with a view to illustrating the over-linear assumptions of such discourses, the article articulates the biographies of practising researchers in this field through narrative reconstructions of the five authors' own routes as researchers into HE, openly acknowledging their temporalities and serendipitous conditionalities. Finally, we consider the nature of a career in the context of the professionalisation of routes into HE research. Our concluding remarks return us to the question of the status of HE research and to suggestions of positive ways to embrace the dilemmas we face. \copyright{} 2015 HERDSA.},
  langid = {english},
  keywords = {/unread,early career researchers,newer researcher,research into higher education,researcher identities}
}

@article{handleyLearningMarkExemplars2013,
  title = {Learning to Mark: {{Exemplars}}, Dialogue and Participation in Assessment Communities},
  author = {Handley, K. and {den Outer}, B. and Price, M.},
  year = 2013,
  journal = {Higher Education Research and Development},
  volume = {32},
  number = {6},
  pages = {888--900},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360.2013.806438},
  abstract = {The problems of shifting from norm-referenced assessment to criterion-referenced assessment have been identified by several scholars in recent years. These important critiques touch on a number of areas, but neglect a key question about how assessors learn to accomplish what Shay calls a 'socially situated interpretive act'. Research that does exist tends to focus on salaried, full-time academics. This overlooks the heterogeneity of the academic labour force in higher education and the substantial contribution made by contract (hourly-paid) lecturers, particularly in applied disciplines such as Business and Management. This study explores how nine newcomers to a UK Business School - including salaried and contract staff - attempt to understand local assessment practice. We use a situated learning lens to analyse their diary entries and interviews about their experiences of learning to mark. Drawing on scholars such as Sadler, we examine the suggestion that exemplars are important for newcomers coming to understand local assessment practice. We argue for the fundamental importance of dialogue about exemplars and other aspects of practice, both to develop inter-subject understandings of assessment 'anchor points' and also to foster among newcomers (and especially contract lecturers) a greater sense of participating in, and being valued by, the local assessment community. \copyright{} 2013 HERDSA.},
  langid = {english},
  keywords = {/unread,contract lecturers,criterion-referenced assessment,dialogue,exemplars,participation,situated learning}
}

@article{hanFacultyStressorsTheir2021,
  ids = {hanFacultyStressorsTheir2021a},
  title = {Faculty Stressors and Their Relations to Teacher Efficacy, Engagement and Teaching Satisfaction},
  author = {Han, J. and Perron, B. E. and Yin, H. and Liu, Y.},
  year = 2021,
  journal = {Higher Education Research and Development},
  volume = {40},
  number = {2},
  pages = {247--262},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360.2020.1756747},
  abstract = {This study investigated faculty-perceived stressors and their relationships with teacher efficacy, engagement and teaching satisfaction in mainland China. The results of a survey of 2758 faculty members from 25 public institutions showed a generally high level of stress, and the stress varied among different types of institution and demographic groups. In a series of bivariate analyses and structural equation models, we found no compelling evidence that faculty stressors were associated with efficacy, engagement, or satisfaction. Instead, our findings show that efficacy is a key factor in explaining the variation in teaching outcomes. These findings suggest a need to elaborate our theoretical models on faculty development and stress to include processes of stress appraisal and coping. \copyright{} 2020 HERDSA.},
  langid = {english},
  keywords = {/unread,China,Stressors,teacher efficacy,teacher engagement,teaching satisfaction}
}

