  pages = {420--435},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360.2012.682255 10.1016/S1471-5953(03)00004-0; Dean, C.M., Stark, A.M., Gates, C.A., Czerniec, S.A., Hobbs, C.L., Bullock, L.D., Kolodziej, I., A profile of physiotherapy clinical education (2009) Australian Health Review, 33 (1), pp. 38-46. , doi:10.1071/AH090038; (2011) Clinical placement planning (multi-lateral negotiations): Framework, , Department of Health, Melbourne, Melbourne,: Victorian Government Department of Health; Devine, S., Perceptions of occupational therapists practising in rural Australia: A graduate perspective (2006) Australian Occupational Therapy Journal, 53 (3), pp. 205-210. , doi:10.1111/j.1440-1630.2006.00561.x; Doubt, L., Paterson, M., O'Riordan, A., A clinical education in private practice: An interdisciplinary project (2004) Journal of Allied Health, 33, pp. 44-47; Harris, L.M., Cumming, S.R., Campbell, A.J., Stress and psychological well-being among allied health professionals (2006) Journal of Allied Health, 35 (4), pp. 198-207; (2010) Agency resources and planned performance, , Health Workforce Australia (HWA), Canberra, ACT, Canberra, ACT,: Health and Ageing Portfolio Agency, Australian Government; Hughes, R., University-initiated strategies to increase supervisory capacity and benefits associated with dietetic student supervision- perceptions of dietetic placement sites (2002) Nutrition and Dietetics, 59 (3), pp. 191-194; Kauffman, T., Maloney, P., Schoo, A., Working in private practice (2010) Clinical fieldwork placement in the health professions, , In: Stagnitti K., Schoo A., Welch D., editors Melbourne, VIC, Melbourne, VIC,: Oxford University Press; Ladyshewsky, R.W., Bird, N., Finney, J., The impact on departmental productivity during physical therapy student placements: An investigation of outpatient physical therapy services (1994) Physiotherapy Canada, 46, pp. 89-93; Ladyshewsky, R., Enhancing service productivity in acute care inpatient settings using a collaborative clinical education model (1995) Physical Therapy, 75 (12), pp. 1137-1139; Lindsay, R., Hanson, L., Taylor, M., McBurney, H., Workplace stressors experienced experienced by physiotherapists in regional public hospitals (2008) Australian Journal of Rural Health, 16 (4), pp. 194-200. , doi:10.1111/j.1440-1584.2008.00980.x; Lowe, S., Clinical education for allied health students and rural clinical placements: Services for Australian Rural and Remote Allied Health (2007) SARRAH Issues Paper, pp. 1-8; Lowe, S., O'Kane, A., (2004) National allied health workforce report, pp. 1-20. , Deakin, ACT, Deakin, ACT,: Services to Australian Rural and Remote Allied Health; Ohman, A., Hagg, K., Dahlgren, L., A stimulating, practice-based job facing increased stress: Clinical supervisors' perceptions of professional role, physiotherapy education and the status of the profession (2005) Advances in Physiotherapy, 7, pp. 114-122. , doi:10.1080/14038190510010359; O'Toole, K., Schoo, A., Stagnitti, K., Cuss, K., Rethinking the policies for the retention of allied health professionals in rural areas: A social relations approach (2008) Health Policy, 87 (3), pp. 326-332. , doi:10.1016/j.healthpol.2008.01.012; Paterson, M.L., McColl, M.A., Paterson, J.A., Preparing allied health students for fieldwork in smaller communities (2004) Australian Journal of Rural Health, 12 (1), pp. 32-33. , doi:10.1111/j.1440-1584.2004.00543.x; Pereira, R., Practical practice pointers (2008) Learning and being a first-time student supervisor, Learning and being a first-time student supervisor,: Challenges and triumphs, Australian Journal of Rural Health, 16 (4), pp. 247-248; Potts, H., Babcock, J., McKee, M., Considerations for fieldwork education within a private practice (1998) Canadian Journal of Occupational Therapy, 65 (2), pp. 104-108; Price, R., Hopwood, N., Pearce, V., Auditing the clinical placement experience (2000) Radiography, 6 (3), pp. 151-159. , doi:10.1053/radi.2000.0255; Rorke, L., (2005) Clinical education in private practice: Creating a win-win-win for students, universities and private practitioners (Discussion paper), , Brisbane, Queensland Occupational Therapy Collaborative; Shannon, S.J., Walker Jeffreys, M., Newbury, J.W., Cayetano, T., Brown, K., Petkov, J., Rural clinician opinion of being a preceptor (2006) Rural and Remote Health, 6 (490), pp. 1-13; Sloggett, K., Kim, N., Cameron, C., Private practice: Benefits, barriers and strategies of providing fieldwork placements (2003) Canadian Journal of Occupational Therapy, 70 (1), pp. 42-50; Smith, J.D., (2007) Australia's rural and remote health: A social justice perspective, , Croydon, VIC, Croydon, VIC,: Tertiary Press; Sobiechowska, P., Maisch, M., Work-based learning: In search of an effective model (2006) Educational Action Research, 14 (2), pp. 267-286. , doi:10.1080/09650790600718217; Stagnitti, K., Schoo, A., Reid, C., Dunbar, J., Retention of allied health professionals in the south-west of Victoria (2005) Australian Journal of Rural Health, 13 (6), pp. 364-365. , doi:10.1111/j.1440-1584.2005.00732.x; Stagnitti, K., Schoo, A., Dunbar, J., Reid, C., An exploration of issues of management and intention to stay: Allied health professionals in south west Victoria, Australia (2006) Journal of Allied Health, 35 (4), pp. 226-232; Stagnitti, K., Schoo, A., Welch, (2010) Clinical fieldwork placement in the health professions, , In: Stagnitti K., Schoo A., Welch, editors Melbourne, VIC, Melbourne, VIC,: Oxford University Press; Struber, J.C., Recruiting and retaining allied health professionals in rural Australia: Why is it so difficult? (2004) International Journal of Allied Health and Science and Practice, 2 (2), pp. 1-8; Swallow, V., Chalmers, H., Piercy, C., Sen, B., Accredited work-based learning (AWBL) for new nursing roles: Nurses' experiences of two pilot schemes (2001) Journal of Clinical Nursing, 10 (6), pp. 820-821. , doi:10.1046/j.1365-2702.2001.00547.x; Thomas, Y., Clark, M., The aptitudes of allied health professionals working in remote communities (2007) International Journal of Therapy and Rehabilitation, 14 (5), pp. 216-220; (2007) Clinical placements in Victoria: Establishing a state-wide approach, , Victorian DHS, Melbourne, Melbourne,: Victorian Government Department of Human Services; (2008) Considering a clinical placement agency (Discussion paper), , Victorian DHS, Melbourne, Melbourne,: Victorian Government Department of Human Services; Vogel, K.A., Grice, K.A., Hill, S., Moody, J., Supervisor and student expectations of level II fieldwork (2004) Occupational Therapy in Health Care, 18 (1), pp. 5-19. , doi:10.1300/J003v18n01_02; Williams, C., Understanding the essential elements of work-based learning and its relevance to everyday clinical practice (2010) Journal of Nursing Management, 18 (6), pp. 624-632. , doi:10.1111/j.1365-2834.2010.01141.x},
  abstract = {There is a need to maximise rural clinical fieldwork placement to build health workforce capacity. This study investigated allied health professionals' (AHPs) experience of supervising students as part of work-integrated learning in public and private rural health settings. An anonymous postal questionnaire with 30 questions was used to collect quantitative and qualitative data about the barriers and enablers that AHPs encounter when supervising students in their clinical setting. A total of 113 public and private AHPs from Southwest Victoria, Australia, returned the questionnaire. The AHPs were trained in the disciplines of occupational therapy, physiotherapy, speech pathology, dietetics, podiatry or psychology. The majority of respondents (75\%) had previously supervised students. Most respondents had only provided fieldwork education in the public sector. Allied health professionals working in public and private sectors had positive experiences with clinical fieldwork education and often had increased job satisfaction while supervising students. They experienced similar enablers to involvement in clinical fieldwork education programs, however the barriers they encountered were different. The findings highlight the differing issues between rural public and private settings that need to be addressed for successful clinical fieldwork education and work-integrated learning. Strategies to address the identified barriers need to be specific to the work conditions of each setting. \copyright{} 2013 Copyright HERDSA.},
  langid = {english},
  keywords = {/unread,clinical fieldwork education,clinical fieldwork placement,public and private sectors,rural allied health,student supervision,work-integrated learning}
}

@article{maloshonokUndergraduateTimeuseComparison2020,
  ids = {maloshonokUndergraduateTimeuseComparison2020a},
  title = {Undergraduate Time-Use: A Comparison of {{US}}, {{Chinese}}, and {{Russian}} Students at Highly Selective Universities},
  author = {Maloshonok, N.},
  year = 2020,
  journal = {Higher Education Research and Development},
  volume = {39},
  number = {3},
  pages = {515--531},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360.2019.1684453},
  abstract = {Patterns of students' time-use can provide important insights into student learning and development in higher education. Previous empirical studies conducted in developed countries do not allow us to generalize findings on time-use patterns for students from countries with different national systems. This paper aims to identify national differences in undergraduate patterns of time-use and their links with the individual characteristics of students. The sample (N = 166,919) was derived from highly selective universities from three countries: the USA, China, and Russia. Significant differences in undergraduate time-use patterns in three countries were observed. In addition, significant interaction effects between national variables and individual characteristics were found. The results allow us to conclude that there are national differences in the power and direction of links between time-use patterns and individual characteristics. \copyright{} 2019, \copyright{} 2019 HERDSA.},
  langid = {english},
  keywords = {/unread,cross-national study,Patterns of time-use,student experience,time allocation}
}

@article{mampaeyBrandingFlemishHigher2015,
  title = {Branding of {{Flemish}} Higher Education Institutions: A Strategic Balance Perspective},
  author = {Mampaey, J. and Huisman, J. and Seeber, M.},
  year = 2015,
  journal = {Higher Education Research and Development},
  volume = {34},
  number = {6},
  pages = {1178--1191},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360.2015.1024634},
  abstract = {Branding of higher education institutions (HEIs) is an expanding area of research. The existing literature mainly draws on the strategic management perspective that argues that HEIs are pressured to develop brands which differentiate them from their competitors. Past studies, however, do insufficiently take into account that most HEIs are positioned in systems that contain both competitive pressures (to differentiate) and institutional pressures (to meet taken-for-granted expectations), where neither of the pressures is clearly dominant. Our multiple case study of the five Flemish universities finds that branding can simultaneously address competitive and institutional pressures and that the universities studied combine aspects of distinctiveness with elements of similarity. \copyright{} 2015 HERDSA.},
  langid = {english},
  keywords = {/unread,branding,Flemish universities,multiple case study,strategic balance}
}

@article{mampaeyInternalBrandingHigher2020,
  ids = {mampaeyInternalBrandingHigher2020a},
  title = {Internal Branding in Higher Education: Dialectical Tensions Underlying the Discursive Legitimation of a New Brand of Student Diversity},
  author = {Mampaey, J. and Schtemberg, V. and Schijns, J. and Huisman, J. and W{\ae}raas, A.},
  year = 2020,
  journal = {Higher Education Research and Development},
  volume = {39},
  number = {2},
  pages = {230--243},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360.2019.1674252},
  abstract = {Most studies on branding in higher education focus on external branding or image-building towards external stakeholders such as students. Internal branding is an underexplored topic, even though it should be considered as important as external branding. Internal branding is about achieving the necessary internal support for the external brand. Drawing on the theoretical concept of discursive legitimation, we explore the strategies that contribute to an internally supported new brand with student diversity as brand value. We conducted a case study of a Flemish university college that has (largely) succeeded in achieving internal support for its new external brand of student diversity. Analyzing the case from the perspective of Critical Discourse Analysis, we specifically zoomed in on the dialectical tensions underlying the discursive legitimation of this new brand. We identified three specific tensions, which illustrate the inherent complexity of the internal branding process: authorization as (dis)empowerment, normalization as (dis)empowerment and moralization as (dis)empowerment. \copyright{} 2019, \copyright{} 2019 The Author(s). Published by Informa UK Limited, trading as Taylor \& Francis Group.},
  langid = {english},
  keywords = {/unread},
  file = {/home/lc/snap/zotero-snap/common/Zotero/storage/XYPU8AHJ/Mampaey et al. - 2020 - Internal branding in higher education dialectical tensions underlying the discursive legitimation o.pdf}
}

