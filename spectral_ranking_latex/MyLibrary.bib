@article{marxDetectingHistoricalRoots2014,
  title = {Detecting the Historical Roots of Research Fields by Reference Publication Year Spectroscopy ({{RPYS}})},
  author = {Marx, Werner and Bornmann, Lutz and Barth, Andreas and Leydesdorff, Loet},
  year = 2014,
  journal = {Journal of the Association for Information Science and Technology},
  volume = {65},
  number = {4},
