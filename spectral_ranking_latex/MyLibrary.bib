@article{magnellSeamlessBlendResearch2019,
  ids = {magnellSeamlessBlendResearch2019a},
  title = {A Seamless Blend of Research and Professional Practice: Dual Coupling in Engineering Education},
  author = {Magnell, M. and Geschwind, L.},
  year = 2019,
  journal = {Higher Education Research and Development},
  volume = {38},
  number = {4},
  pages = {807--818},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360.2019.1581141},
  abstract = {The purpose of this article is to challenge the idea of incompatibility between links to research and links to professional practice in engineering education. The concept of `academic drift' is introduced, both related to drift towards theory and towards research links in the curriculum. Empirical data were collected through a case study conducted at a department in a research-intensive technical university, including semi-structured interviews with academic staff and an analysis of course syllabuses. The results show that the respondents perceive no incompatibility between including links to research and including links to professional practice in engineering education. Indeed, they state that the two aspects are mutually reinforcing and overlapping. Their rationales for incorporating such coupled links to research and professional practice include increased motivation among students and preparing them for employment. In conclusion, including research in the curriculum does not necessarily lead to academic drift; conversely, the curriculum in engineering education can consist of a seamless blend of research and professional practice. \copyright{} 2019, \copyright{} 2019 The Author(s). Published by Informa UK Limited, trading as Taylor \& Francis Group.},
  langid = {english},
  keywords = {/unread,academic drift,engineering education,professional practice,Teaching-research links,work-related learning},
