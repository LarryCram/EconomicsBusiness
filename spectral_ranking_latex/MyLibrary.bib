@article{macfadyenAmDoingIt2019,
  ids = {macfadyenAmDoingIt2019a},
  title = {`{{Am I}} Doing It Right?' {{Conceptualising}} the Practice of Supervising Master's Dissertation Students},
  author = {Macfadyen, A. and English, C. and Kelleher, M. and Coates, M. and Cameron, C. and Gibson, V.},
