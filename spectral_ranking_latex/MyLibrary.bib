  file = {/home/lc/snap/zotero-snap/common/Zotero/storage/A8FBSULU/Stöckelová research assessment.pdf;/home/lc/snap/zotero-snap/common/Zotero/storage/LWG6LB3R/Stöckelová research assessment.pdf}
