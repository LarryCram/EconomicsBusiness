  pages = {121--133},
  issn = {07294360 (ISSN)},
  doi = {10.1080/0729436870060204},
  abstract = {Research into the nature and extent of problems faced by over-seas students in Australia is based almost entirely on surveys of this population either by staff of support services or by or on behalf of policy making bodies. The nature of educational difficulties --- 'language' and 'study' problems --- is still relatively unknown, however it has been explored to some extent by study skills counsellors and teachers of English as a second language. Little is known about perception of these problems by academic staff. This paper describes learning problems of overseas students as seen by the academic staff at the University of Queensland and compares them with the perception of learning problems held by overseas students. Academic staff (145) representing 50 departments, and 136 overseas students representing 14 courses at postgraduate level and 10 courses at undergraduate level responded to questionnaires identifying educational problems and suggesting possible solutions. Copyright \copyright{} 1987 by Taylor \& Francis Group, LLC. All rights reserved.},
