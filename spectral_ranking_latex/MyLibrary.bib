@article{CorrigendumEasyMoney2015,
  title = {Corrigendum to: {{Easy Money}}: {{Tax Exporting}} and {{State Support}} for {{Higher Education}}: {{Tax Exporting}} and {{State Support}} for {{Higher Education}} ({{Journal}} of {{Policy Analysis}} and {{Management}}, (2016), 35, 2, (415-440), 10.1002/Pam.21813)},
  year = 2015,
  journal = {Journal of Policy Analysis and Management},
  volume = {34},
  number = {3},
  pages = {e1-e2},
  doi = {10.1002/pam.21874},
  abstract = {Foster, J. M. and Fowles, J. (2014). Easy Money: Tax Exporting and State Support for Higher Education. Journal of Policy Analysis and Management. doi: 10.1002/pam.21813 This article was published online on 30 December 2014. Subsequently, we uncovered a coding error that affects the validity of the manuscript's findings with respect to the relationship between the net-of-deductibility price of business taxes and the median voter's tax price. The error is that we unintentionally used the corporate share of a state's business income as our measure of corporate ownership rather than the ratio between a state's share of the nation's corporate profits and the share of the nation's capital income received by that state's residents, which is the measure that is described in the text. When this error is fixed, the corporate ownership measure becomes statistically significant and negative while the net-of-deductibility price of business taxes ceases to be a statistically significant predictor of the median voter's tax price. The revised article was published on 19 August 2015. The following list provides information as to the specific changes made to the manuscript following the correction of the coding mistake. The page numbers listed below in the left margin indicate the location of the corrections as they appear in the revised article. Page 1: We changed the abstract to reflect the new results. Page 2: In the fourth full paragraph, we edited the brief summary of the tax exporting variables that are significantly related to the median voter's tax price. Specifically, we deleted the discussion of net-of-deductibility price of business taxes as a significant variable. We added text discussing the significance of the corporate ownership index. Page 15--16: We deleted the text describing the effects of the net-of-deductibility price of business taxes as a significant determinant of the median voter's tax price. We replaced it with a discussion of the statistical insignificance of the business tax price variable. We added text discussing the effects of the nonresident ownership of capital (i.e. the corporate ownership index) on the median voter's tax price. We made slight adjustments to the estimated effects of the mining and tourism variables on the median voter's tax price. These changes were necessitated by the small changes in the coefficients on those variables which occurred when we replaced the unintended corporate ownership index with the intended one. We deleted text that describes the partial dependence of the effect of the mining index on the effect of the mining index on the business tax price since the business tax price is no longer significant. We added text describing the positive and statistically significant effect of the manufacturing index on the median voter's tax price. The positive sign is counterintuitive and perhaps reflects a willingness among state governments to forgo short-term tax exporting benefits in exchange for manufacturing jobs. When the incorrect business tax price measure was used, the manufacturing index was statistically insignificant, had a negative sign, and was considerably smaller in magnitude. We deleted Table 4, which presented an auxiliary analysis of the economic determinants of the net-of-deductibility price of business taxes, since that variable is no long statistically significant. Thus, it was necessary to renumber the remaining tables (i.e. Tables 5, 6, and 7 are now Tables 4, 5, and 6). Page 16: We replaced Table 3 from the original draft with the corrected table. Page 18--19: We deleted text describing the indirect effects of the business tax price variable on state higher education spending. We replaced it with text mentioning the statistically insignificant relationship between the business tax price variable and the median voter's tax price. Page 19: We added discussion of the indirect effect of nonresident capital ownership on state appropriations to public universities. We also adjusted our estimates of the effects of mining and tourism on state appropriations to ref ect the small changes in the coefficients on the mining and tourism indices in the median voter's tax price equation. Page 20: We updated the discussion of the robustness tests for the median voter's tax price equation to reflect the changes that we observe after replacing the unintended corporate ownership index with the correct measure. Page 21: We replaced Table 6 from the original draft (which is now numbered Table 5 in the corrected draft) with the corrected table. Page 23: We revised our summary of the results and discussion of policy implications to reflect the changes in the results. Page 28: We revised the discussion of the robustness test in Appendix A to reflect the changes in the results. \copyright{} 2015 by the Association for Public Policy Analysis and Management},
  keywords = {/unread},
  file = {/home/lc/snap/zotero-snap/common/Zotero/storage/8A5MHIUZ/2015 - Corrigendum to Easy Money Tax Exporting and State Support for Higher Education Tax Exporting and.pdf}
}

