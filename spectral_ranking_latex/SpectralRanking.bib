@article{liuDeepGraphLearning2022,
  title = {Deep {{Graph Learning}} for {{Anomalous Citation Detection}}},
  author = {Liu, Jiaying and Xia, Feng and Feng, Xu and Ren, Jing and Liu, Huan},
  year = 2022,
