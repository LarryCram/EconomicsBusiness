@inproceedings{palCITEXNewCitation2015,
  title = {{{CITEX}}: {{A}} New Citation Index to Measure the Relative Importance of Authors and Papers in Scientific Publications},
  shorttitle = {{{CITEX}}},
  booktitle = {2015 {{IEEE International Conference}} on {{Communications}} ({{ICC}})},
