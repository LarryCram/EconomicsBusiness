@misc{kodrzyckiNewApproachesRanking2006,
  type = {{{SSRN Scholarly Paper}}},
  title = {New {{Approaches}} to {{Ranking Economics Journals}}},
  author = {Kodrzycki, Yolanda K. and Yu, Pingkang David},
  year = 2006,
