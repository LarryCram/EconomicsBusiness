@article{goyanesWhenCitationCounts2025,
  title = {When Citation Counts Don't Count: Detecting Author Citation Discrepancies across Bibliographic Databases to Improve Research Evaluations},
  shorttitle = {When Citation Counts Don't Count},
  author = {Goyanes, Manuel and {Ordu{\~n}a-Malea}, Enrique},
  year = 2025,
  month = dec,
  journal = {Scientometrics},
  issn = {1588-2861},
  doi = {10.1007/s11192-025-05506-9},
  urldate = {2026-01-04},
  abstract = {Measuring academic performance through citation counts and derived indicators has become a sacred ritual in contemporary research evaluations. In this well-established liturgy, Google Scholar (GS) has become a widely used tool among researchers due to its accessibility and broad coverage. While the Bibliometrics community has consistently criticized GS for its lack of editorial control and opaque indexing criteria, its indicators are used to assess research impact in particular disciplines. This practice may lead to questionable citation practices, which only become evident when compared with more curated databases, such as Web of Science (Wos). This letter theoretically introduces and empirically tests an easy-to-implement indicator (the Citation Discrepancy Index, CDI) designed to explore the often-ignored extreme discrepancies in author citation counts across bibliographic databases and scientific fields. While some discrepancy is expected due to differences in coverage and publishing practices, this indicator might assist research evaluation committees in identifying cases where the divergence exceeds a reasonable or acceptable threshold, potentially signalling inconsistencies that merit closer scrutiny. Importantly, high CDI scores should be interpreted with caution: they are diagnostic signals of potential citation inconsistencies, not evidence of misconduct. To provide empirical support for the proposed indicator, several field-sensitive discrepancy thresholds are built to detect GS profiles requiring a full qualitative review.},
  langid = {english},
  keywords = {/unread,Bibliographic databases,Citation discrepancy,Citations,Google Scholar,Research evaluation,Web of Science},
  file = {/home/lc/snap/zotero-snap/common/Zotero/storage/VR3VJQGZ/Goyanes and Orduña-Malea - 2025 - When citation counts don’t count detecting author citation discrepancies across bibliographic datab.pdf}
}

