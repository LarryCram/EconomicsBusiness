@article{westAuthorlevelEigenfactorMetrics2013,
  title = {Author-Level {{Eigenfactor}} Metrics: {{Evaluating}} the Influence of Authors, Institutions, and Countries within the Social Science Research Network Community},
  shorttitle = {Author-Level {{Eigenfactor}} Metrics},
  author = {West, Jevin D. and Jensen, Michael C. and Dandrea, Ralph J. and Gordon, Gregory J. and Bergstrom, Carl T.},
