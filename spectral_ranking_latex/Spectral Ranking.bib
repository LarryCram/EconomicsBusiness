  author = {Borgatti, Stephen P. and Everett, Martin G.},
  year = 1997,
  month = aug,
  journal = {Social Networks},
  volume = {19},
  number = {3},
  pages = {243--269},
  issn = {0378-8733},
  doi = {10.1016/S0378-8733(96)00301-2},
  urldate = {2026-02-13},
  abstract = {Network analysis is distinguished from traditional social science by the dyadic nature of the standard data set. Whereas in traditional social science we study monadic attributes of individuals, in network analysis we study dyadic attributes of pairs of individuals. These dyadic attributes (e.g. social relations) may be represented in matrix form by a square 1-mode matrix. In contrast, the data in traditional social science are represented as 2-mode matrices. However, network analysis is not completely divorced from traditional social science, and often has occasion to collect and analyze 2-mode matrices. Furthermore, some of the methods developed in network analysis have uses in analysing non-network data. This paper presents and discusses ways of applying and interpreting traditional network analytic techniques to 2-mode data, as well as developing new techniques. Three areas are covered in detail: displaying 2-mode data as networks, detecting clusters and measuring centrality.},
  keywords = {Centrality,Clusters,Networks},
  file = {/home/lc/snap/zotero-snap/common/Zotero/storage/MFKLY5I5/Borgatti and Everett - 1997 - Network analysis of 2-mode data.pdf;/home/lc/snap/zotero-snap/common/Zotero/storage/HF2IW24W/S0378873396003012.html}
}

@article{bornmannIdentifyingSeminalBooks2025,
  title = {Identifying Seminal Books in Sociology Using Reference Publication Year Spectroscopy ({{RPYS}}): Do the Results Agree with Experts' Identifications?},
  shorttitle = {Identifying Seminal Books in Sociology Using Reference Publication Year Spectroscopy ({{RPYS}})},
  author = {Bornmann, Lutz},
  year = 2025,
  month = dec,
  journal = {Scientometrics},
  issn = {1588-2861},
  doi = {10.1007/s11192-025-05509-6},
  urldate = {2025-12-23},
  abstract = {Often, a few publications determine the fundamentals of a discipline, and these publications should be known (e.g., to recommend them to students). This study employed reference publication year spectroscopy (RPYS) to trace the historical foundations of sociology by cited references peaks in a corpus of 6518 journal papers published in 1997 and their 77,456 cited references spanning from 1800 to 2000. Building on prior RPYS applications in other disciplines, this study validated bibliometric peaks against the books nominated by sociologists in an 1997 experts' survey. RPYS produced clear peaks in 1897 (Durkheim's ``Le Suicide''), 1934 (Mead's ``Mind, self, and society''), 1950 (Simmel's ``The sociology of Georg Simmel''), 1994 (Coleman's ``Foundations of social theory''), and 1995 (Smith's ``Nations and nationalism''). In contrast, seminal works by Max Weber, Robert K. Merton, Charles Wright Mills, Peter L. Berger and Thomas Luckmann, Pierre Bourdieu, Erving Goffman, and J\"urgen Habermas did not generate distinct peaks in the spectrogram. The findings demonstrate that RPYS effectively detects works that concentrate in single reference publication years but underrepresents enduring classics with fragmented cited references. The study highlights the necessity of combining RPYS with manual variant aggregation of cited references and expert judgment to construct a meaningful map of sociology's intellectual roots. Future research should extend RPYS by integrating advanced disambiguation algorithms to better merge cited references variants.},
  langid = {english},
  keywords = {Citation analysis,Reference publication year spectroscopy (RPYS),Sociology},
  file = {/home/lc/snap/zotero-snap/common/Zotero/storage/RWGMHVZE/Bornmann - 2025 - Identifying seminal books in sociology using reference publication year spectroscopy (RPYS) do the.pdf}
}

